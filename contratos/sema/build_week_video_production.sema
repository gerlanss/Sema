module sema.showcase.build_week_2026.video_production {
  docs {
    resumo: "Governa a captura de evidencias, montagem audiovisual com narracao natural, saneamento de caminhos e verificacao final do video Sema para a OpenAI Build Week 2026."
  }

  vinculos {
    arquivo: "showcase/build-week-2026/video-production/.gitignore"
    arquivo: "showcase/build-week-2026/video-production/README.md"
    arquivo: "showcase/build-week-2026/video-production/package.json"
    arquivo: "showcase/build-week-2026/video-production/package-lock.json"
    arquivo: "showcase/build-week-2026/video-production/production.json"
    arquivo: "showcase/build-week-2026/video-production/capture-evidence.mjs"
    arquivo: "showcase/build-week-2026/video-production/build.mjs"
    arquivo: "showcase/build-week-2026/video-production/verify.mjs"
    simbolo: video_production.capture_evidence.captureEvidence
    simbolo: video_production.build.buildVideoProduction
    simbolo: video_production.verify.verifyVideoProduction
  }

  task capturar_evidencia_showcase {
    input {
      reason: Texto required
    }
    output {
      verified: Booleano
      paths_sanitized: Booleano
      commands: Lista
    }
    rules {
      reason deve_ser preenchido
    }
    effects {
      shell.exec demo harness criticidade = media
      fs.write evidence logs criticidade = media
      auditoria build week evidence capture criticidade = baixa
    }
    authz {
      escopo: sema.showcase.video.evidence.capture
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: obrigatoria
      input {
        reason: publico
      }
      output {
        verified: publico
        paths_sanitized: publico
        commands: publico
      }
    }
    audit {
      evento: sema.showcase.video.evidence_captured
      ator: produtor.build_week
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      network.egress
      registrar_caminho_absoluto_do_workspace
      registrar_segredo_ou_token
      fabricar_saida_do_harness
    }
    impl {
      js: video_production.capture_evidence.captureEvidence
    }
    vinculos {
      arquivo: "showcase/build-week-2026/video-production/capture-evidence.mjs"
      simbolo: video_production.capture_evidence.captureEvidence
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "180s"
      retry: "nenhum"
      compensacao: "restaurar estado final verde do demo"
      criticidade_operacional: media
    }
    guarantees {
      verified == verdadeiro
      paths_sanitized == verdadeiro
      commands existe
    }
    tests {
      caso "captura apenas evidencia real e publica" {
        given {
          reason: "record final Build Week proof"
        }

        expect {
          sucesso: verdadeiro
          verified: verdadeiro
          paths_sanitized: verdadeiro
        }
      }
    }
  }

  task construir_video_showcase {
    input {
      narration_files: Lista required
      target_duration_seconds: Inteiro required
    }
    output {
      video_path: Texto
      thumbnail_path: Texto
      captions_path: Texto
      narration_preserved: Booleano
      semantic_navigation_explicit: Booleano
      duration_under_180: Booleano
      captions_burned: Booleano
      paths_sanitized: Booleano
    }
    rules {
      narration_files deve_ser nove_mp3_elevenlabs
      target_duration_seconds > 0
      target_duration_seconds < 180
    }
    effects {
      shell.exec ffmpeg criticidade = alta
      fs.write video assets criticidade = alta
      auditoria build week video build criticidade = media
    }
    authz {
      escopo: sema.showcase.video.build
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: obrigatoria
      input {
        narration_files: publico
        target_duration_seconds: publico
      }
      output {
        video_path: publico
        thumbnail_path: publico
        captions_path: publico
        narration_preserved: publico
        semantic_navigation_explicit: publico
        duration_under_180: publico
        captions_burned: publico
        paths_sanitized: publico
      }
    }
    audit {
      evento: sema.showcase.video.built
      ator: produtor.build_week
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      remover_narracoes_elevenlabs
      sintetizar_fallback_sapi
      acelerar_audio_com_ffmpeg
      publicar_automaticamente
      registrar_caminho_absoluto_do_workspace
    }
    impl {
      js: video_production.build.buildVideoProduction
    }
    vinculos {
      arquivo: "showcase/build-week-2026/video-production/build.mjs"
      arquivo: "showcase/build-week-2026/video-production/production.json"
      simbolo: video_production.build.buildVideoProduction
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "900s"
      retry: "nenhum"
      compensacao: "preservar os MP3 de entrada e manter o ultimo export local ate a verificacao"
      criticidade_operacional: alta
    }
    guarantees {
      video_path existe
      thumbnail_path existe
      captions_path existe
      narration_preserved == verdadeiro
      semantic_navigation_explicit == verdadeiro
      duration_under_180 == verdadeiro
      captions_burned == verdadeiro
      paths_sanitized == verdadeiro
    }
    tests {
      caso "exporta video publicavel abaixo de tres minutos" {
        given {
          narration_files: "nove MP3 ElevenLabs Dan Multilingual v2"
          target_duration_seconds: 178
        }

        expect {
          sucesso: verdadeiro
          narration_preserved: verdadeiro
          semantic_navigation_explicit: verdadeiro
          duration_under_180: verdadeiro
          captions_burned: verdadeiro
          paths_sanitized: verdadeiro
        }
      }
    }
  }

  task verificar_video_showcase {
    input {
      video_path: Texto required
      thumbnail_path: Texto required
      captions_path: Texto required
    }
    output {
      approved: Booleano
      duration_under_180: Booleano
      resolution_ok: Booleano
      audio_ok: Booleano
      captions_ok: Booleano
      visual_review_ready: Booleano
      paths_sanitized: Booleano
    }
    rules {
      video_path deve_ser arquivo_mp4
      thumbnail_path deve_ser arquivo_png
      captions_path deve_ser arquivo_srt
    }
    effects {
      shell.exec ffprobe criticidade = media
      fs.write verification evidence criticidade = media
      auditoria build week video verification criticidade = media
    }
    authz {
      escopo: sema.showcase.video.verify
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: obrigatoria
    }
    audit {
      evento: sema.showcase.video.verified
      ator: produtor.build_week
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      aprovar_sem_audio
      aprovar_duracao_maior_ou_igual_a_180
      aprovar_resolucao_diferente_de_1920x1080
      registrar_caminho_absoluto_do_workspace
    }
    impl {
      js: video_production.verify.verifyVideoProduction
    }
    vinculos {
      arquivo: "showcase/build-week-2026/video-production/verify.mjs"
      simbolo: video_production.verify.verifyVideoProduction
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "180s"
      retry: "nenhum"
      criticidade_operacional: media
    }
    guarantees {
      approved == verdadeiro
      duration_under_180 == verdadeiro
      resolution_ok == verdadeiro
      audio_ok == verdadeiro
      captions_ok == verdadeiro
      visual_review_ready == verdadeiro
      paths_sanitized == verdadeiro
    }
    tests {
      caso "valida midia e evidencias publicaveis" {
        given {
          video_path: "sema-build-week-demo.mp4"
          thumbnail_path: "thumbnail.png"
          captions_path: "captions.srt"
        }

        expect {
          sucesso: verdadeiro
          approved: verdadeiro
          duration_under_180: verdadeiro
          paths_sanitized: verdadeiro
        }
      }
    }
  }
}

module sema.produto.cli_sessao {
  docs {
    resumo: "Comando sessao devolve envelope compacto de abertura: identidade, hash, frescor, contratos, gates e proximos passos."
    arquivo: "docs/commands.md"
  }

  task abrir_sessao_governada {
    input {
      intencao: Texto
      mudanca_id: Texto
      entrada: Texto
      janela_contexto: Numero
      orcamento_contexto: Numero
      reserva_saida: Numero
    }
    output {
      workspace_identificado: Booleano
      hash_contratos_calculado: Booleano
      frescor_avaliado: Booleano
      gates_expostos: Booleano
      docs_bloqueantes_por_intencao: Booleano
      proximos_passos_emitidos: Booleano
    }
    rules {
      intencao deve_ser usada_para_gates_especificos
    }
    authz {
      escopo: sema.sessao.abrir
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        intencao: publico
        entrada: interno
      }
      output {
        workspace_identificado: interno
        hash_contratos_calculado: publico
        frescor_avaliado: publico
        gates_expostos: publico
        docs_bloqueantes_por_intencao: publico
        proximos_passos_emitidos: publico
      }
    }
    audit {
      evento: sema.sessao.aberta
      ator: agente.sema
      correlacao: request_id
      retencao: "7d"
      motivo: obrigatorio
    }
    forbidden {
      exigir_indice_bruto_na_abertura
      adivinhar_janela_do_modelo
      persistir_perfil_sem_opcao_explicita
      ocultar_candidatos_omitidos_pelo_orcamento
      tratar_estimativa_de_tokens_como_contagem_exata
      usar_indice_desatualizado_para_direcionar_edicao
      emitir_dados_de_codigo_vivo
      esconder_stale_do_agente
      reutilizar_conclusao_da_conversa_sem_recompilar_contratos_do_escopo
      emitir_sucesso_na_retomada_com_contrato_invalido_ou_protocolo_antigo
      listar_docs_que_nao_sao_bloqueantes_como_bloqueantes
    }
    impl {
      ts: cli.src.comando_sessao.comandoSessao
    }
    vinculos {
      arquivo: "pacotes/cli/src/cliArgs.ts"
      arquivo: "pacotes/cli/src/contextBudget.ts"
      arquivo: "pacotes/cli/src/sessionContext.ts"
      arquivo: "testes/unidade/context-budget.test.ts"
      arquivo: "pacotes/cli/src/comandoSessao.ts"
      arquivo: "pacotes/cli/src/sessionContractState.ts"
      arquivo: "pacotes/cli/src/changeScope.ts"
      arquivo: "testes/unidade/fluxo-ia-regressao.test.ts"
      arquivo: "pacotes/cli/src/agentProtocol.ts"
      arquivo: "pacotes/cli/src/index.part04.ts"
      arquivo: "testes/unidade/comando-sessao.test.ts"
      simbolo: cli.src.comando_sessao.comandoSessao
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "15s"
      retry: "nenhum"
      compensacao: "nenhuma"
      criticidade_operacional: media
    }
    guarantees {
      proximos_passos_emitidos deve_ser retomar_intencao_e_arquivos_originais_por_mudanca_id
      proximos_passos_emitidos deve_ser pedir_contrato_do_usuario_quando_projeto_adotado_nao_tem_contratos
      proximos_passos_emitidos deve_ser nao_selecionar_exemplos_como_dominio_inferido
      proximos_passos_emitidos deve_ser contar_instrucoes_locais_e_entrega_no_mesmo_orcamento
      frescor_avaliado deve_ser detectar_troca_do_perfil_materializado
      proximos_passos_emitidos deve_ser limitar_contexto_por_orcamento_de_caracteres_estimados
      proximos_passos_emitidos deve_ser perguntar_janela_ausente_antes_de_contexto
      frescor_avaliado deve_ser exigir_indice_atual_para_navegacao
      frescor_avaliado deve_ser verificar_protocolo_materializado_mesmo_sem_mudanca_de_contratos
      proximos_passos_emitidos deve_ser retomar_com_hash_validacao_e_tarefas_reconhecidas_atuais
      proximos_passos_emitidos deve_ser distinguir_validacao_atual_de_drift_e_comportamento_nao_avaliados
      proximos_passos_emitidos deve_ser recompilar_fechamento_de_use_sem_abrir_codigo_ou_contratos_laterais
      frescor_avaliado deve_ser preservar_regras_manuais_fora_do_bloco_gerenciado
      proximos_passos_emitidos deve_ser declarar_omissoes_e_nao_autorizar_execucao
      workspace_identificado == verdadeiro
      hash_contratos_calculado == verdadeiro
      frescor_avaliado == verdadeiro
      gates_expostos == verdadeiro
      docs_bloqueantes_por_intencao existe
      proximos_passos_emitidos existe
    }
    tests {
      caso "sessao com intencao devolve gates e docs" {
        given {
          intencao: "alterar design do painel"
          entrada: "."
        }

        expect {
          sucesso: verdadeiro
          gates_expostos: verdadeiro
        }
      }
    }
  }
}

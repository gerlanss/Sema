module sema.produto.fronteira_repositorios {
  docs {
    arquivo: "contratos/sema/fronteira_repositorios_empacotamento.sema"
    resumo: "Contrato de fronteira publica Codex-native e local-only do Sema. O pacote contem a CLI sem autorizacao, licenca, credito, token ou painel e uma skill Sema portatil instalada na raiz compartilhada ~/.agents, com espelho Claude gerenciado quando suportado. Essa portabilidade nao cria entrypoints de workspace para outros clientes: AGENTS.md continua sendo o unico protocolo automatico do projeto e a skill apenas faz bootstrap ou reparo. Caches de plugin, materiais privados e artefatos sensiveis ficam fora da distribuicao. A fonte e publica, mas nao pode ser replicada para venda comercial sem permissao escrita da OtimiTare."
  }

  use sema.produto.fronteira_repositorios.empacotamento

  vinculos {
    arquivo: "scripts/verificar-fronteira-publica.mjs"
    arquivo: "scripts/empacotar-cli-publica.mjs"
    arquivo: "scripts/publicar-cli-npm.mjs"
    arquivo: "scripts/testar-pacote-cli-publico.mjs"
    arquivo: "scripts/cli-publico/bootstrap-codex.mjs"
    arquivo: "scripts/cli-publico/fronteira-publica.mjs"
    arquivo: "scripts/cli-publico/pipeline-conteudo.mjs"
    arquivo: "scripts/cli-publico/sistemas-interativos.mjs"
    arquivo: "scripts/cli-publico/toolchains-geradas.mjs"
    arquivo: "scripts/testar-plugin-codex.mjs"
    arquivo: "README.md"
    arquivo: "LICENSE"
    arquivo: "docs/repositories.md"
    arquivo: "docs/security.md"
    arquivo: "pacotes/cli/package.json"
    arquivo: ".agents/plugins/marketplace.json"
    arquivo: "plugins/sema/.codex-plugin/plugin.json"
    arquivo: "logo.png"
    arquivo: "plugins/sema/assets/sema.png"
    arquivo: "plugins/sema/skills/sema/SKILL.md"
    arquivo: "plugins/sema/skills/sema/agents/openai.yaml"
    arquivo: "pacotes/cli/scripts/postinstall.mjs"
    arquivo: "pacotes/cli/src/distribuicao/index.ts"
    arquivo: "pacotes/cli/src/distribuicao/launcherGlobal.ts"
    arquivo: "pacotes/cli/src/distribuicao/skillGlobal.ts"
    simbolo: scripts.verificar_fronteira_publica.verificarFronteiraPublica
  }

  type ResultadoFronteiraPublica {
    fields {
      aprovado: Booleano
      bloqueado: Booleano
      fronteira: Texto
      suporte: Texto
      politica_comercial: Texto
      bloqueios: Lista
      avisos: Lista
    }
  }

  task verificar_fronteira_publica_local_only {
    input {
      repositorio: Texto required
      suporte_oficial: Texto required
      licenca_nao_comercial: Booleano required
    }
    output {
      sucesso: Booleano
      resultado: ResultadoFronteiraPublica
      materiais_privados_ausentes: Booleano
      artefatos_sensiveis_ausentes: Booleano
      segredos_ausentes: Booleano
      docs_publicas_em_ingles: Booleano
      suporte_email_oficial: Booleano
      revenda_comercial_bloqueada: Booleano
      produto_codex_native: Booleano
      cli_sem_autorizacao_local: Booleano
      skill_bootstrap_codex_oficial: Booleano
      plugin_marca_oficial: Booleano
      skill_delega_ao_agents_md: Booleano
      plugin_sem_mcp_auth: Booleano
      protocolo_sem_nomes_mcp: Booleano
      artefatos_bootstrap_existentes: Booleano
      texto_publico_sem_mojibake: Booleano
      skill_portatil_global_oficial: Booleano
      skill_agents_canonica: Booleano
      skill_claude_espelho_gerenciado: Booleano
      workspace_entrypoint_unico_agents_md: Booleano
      cache_plugin_intocado: Booleano
      decisao_agente: Texto
    }
    rules {
      repositorio deve_ser preenchido
      suporte_oficial deve_ser preenchido
      licenca_nao_comercial == verdadeiro
    }
    effects {
      consulta repositorio_local criticidade = alta
      auditoria fronteira_publica_local_only criticidade = alta
    }
    authz {
      escopo: sema.publico.fronteira.verificar
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: obrigatoria
      input {
        repositorio: publico
        suporte_oficial: publico
        licenca_nao_comercial: publico
      }
      output {
        sucesso: publico
        resultado: publico
        materiais_privados_ausentes: publico
        artefatos_sensiveis_ausentes: publico
        segredos_ausentes: publico
        docs_publicas_em_ingles: publico
        suporte_email_oficial: publico
        revenda_comercial_bloqueada: publico
        produto_codex_native: publico
        cli_sem_autorizacao_local: publico
        skill_bootstrap_codex_oficial: publico
        plugin_marca_oficial: publico
        skill_delega_ao_agents_md: publico
        plugin_sem_mcp_auth: publico
        protocolo_sem_nomes_mcp: publico
        artefatos_bootstrap_existentes: publico
        texto_publico_sem_mojibake: publico
        skill_portatil_global_oficial: publico
        skill_agents_canonica: publico
        skill_claude_espelho_gerenciado: publico
        workspace_entrypoint_unico_agents_md: publico
        cache_plugin_intocado: publico
        decisao_agente: publico
      }
    }
    audit {
      evento: sema.publico.fronteira.verificada
      ator: agente.sema
      correlacao: request_id
      retencao: "365d"
      motivo: obrigatorio
    }
    forbidden {
      publicar_credencial
      publicar_env_real
      publicar_chave_pem
      publicar_material_privado
      publicar_artefato_sensivel
      publicar_docs_publicas_em_portugues
      usar_site_como_email_de_suporte
      usar_mit_com_permissao_de_revenda
      permitir_replicacao_para_venda_comercial
      publicar_preflight_de_autorizacao_local
      publicar_billing_licenca_credito_token_ou_painel
      publicar_entrypoint_para_cliente_nao_codex
      publicar_skill_codex_como_opcional
      duplicar_governanca_do_agents_md_na_skill
      publicar_plugin_com_mcp_app_token_ou_auth_propria
      publicar_plugin_com_icone_provisorio
      publicar_plugin_sem_smoke_de_instalacao_codex
      publicar_protocolo_com_nome_de_tool_mcp
      publicar_handshake_com_artefato_inexistente
      publicar_texto_visivel_com_mojibake
      publicar_skill_sema_portatil_como_opcional
      tratar_skill_portatil_como_entrypoint_de_workspace
      gerar_matriz_de_entrypoints_por_cliente
      sincronizar_skill_em_cache_de_plugin_ou_marketplace
    }
    impl {
      ts: scripts.verificar_fronteira_publica.verificarFronteiraPublica
    }
    vinculos {
      arquivo: "scripts/verificar-fronteira-publica.mjs"
      arquivo: "scripts/empacotar-cli-publica.mjs"
      arquivo: "scripts/testar-pacote-cli-publico.mjs"
      arquivo: "scripts/cli-publico/bootstrap-codex.mjs"
      arquivo: "scripts/cli-publico/fronteira-publica.mjs"
      arquivo: "scripts/cli-publico/pipeline-conteudo.mjs"
      arquivo: "scripts/cli-publico/sistemas-interativos.mjs"
      arquivo: "scripts/cli-publico/toolchains-geradas.mjs"
      arquivo: "scripts/testar-plugin-codex.mjs"
      arquivo: "package.json"
      arquivo: "pacotes/cli/package.json"
      arquivo: "README.md"
      arquivo: "LICENSE"
      arquivo: "docs/repositories.md"
      arquivo: ".agents/plugins/marketplace.json"
      arquivo: "plugins/sema/.codex-plugin/plugin.json"
      arquivo: "logo.png"
      arquivo: "plugins/sema/assets/sema.png"
      arquivo: "plugins/sema/skills/sema/SKILL.md"
      arquivo: "plugins/sema/skills/sema/agents/openai.yaml"
      arquivo: "pacotes/cli/scripts/postinstall.mjs"
      arquivo: "pacotes/cli/src/distribuicao/index.ts"
      arquivo: "pacotes/cli/src/distribuicao/launcherGlobal.ts"
      arquivo: "pacotes/cli/src/distribuicao/skillGlobal.ts"
      arquivo: "testes/unidade/fronteira-publica-segredos.test.ts"
      simbolo: scripts.verificar_fronteira_publica.verificarFronteiraPublica
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "30s"
      retry: "nenhum"
      compensacao: "remover artefato privado ou bloquear publicacao"
      criticidade_operacional: alta
    }
    guarantees {
      sucesso == verdadeiro
      resultado existe
      materiais_privados_ausentes == verdadeiro
      artefatos_sensiveis_ausentes == verdadeiro
      segredos_ausentes == verdadeiro
      docs_publicas_em_ingles == verdadeiro
      suporte_email_oficial == verdadeiro
      revenda_comercial_bloqueada == verdadeiro
      produto_codex_native == verdadeiro
      cli_sem_autorizacao_local == verdadeiro
      skill_bootstrap_codex_oficial == verdadeiro
      plugin_marca_oficial == verdadeiro
      skill_delega_ao_agents_md == verdadeiro
      plugin_sem_mcp_auth == verdadeiro
      protocolo_sem_nomes_mcp == verdadeiro
      artefatos_bootstrap_existentes == verdadeiro
      texto_publico_sem_mojibake == verdadeiro
      skill_portatil_global_oficial == verdadeiro
      skill_agents_canonica == verdadeiro
      skill_claude_espelho_gerenciado == verdadeiro
      workspace_entrypoint_unico_agents_md == verdadeiro
      cache_plugin_intocado == verdadeiro
      decisao_agente em [continuar, parar]
    }
    tests {
      caso "repo publico local-only aprovado" {
        given {
          repositorio: "Sema"
          suporte_oficial: "suporte@otimitare.online"
          licenca_nao_comercial: verdadeiro
        }

        expect {
          sucesso: verdadeiro
          materiais_privados_ausentes: verdadeiro
          artefatos_sensiveis_ausentes: verdadeiro
          segredos_ausentes: verdadeiro
          suporte_email_oficial: verdadeiro
          revenda_comercial_bloqueada: verdadeiro
          produto_codex_native: verdadeiro
          cli_sem_autorizacao_local: verdadeiro
          skill_bootstrap_codex_oficial: verdadeiro
          plugin_marca_oficial: verdadeiro
          skill_delega_ao_agents_md: verdadeiro
          plugin_sem_mcp_auth: verdadeiro
          protocolo_sem_nomes_mcp: verdadeiro
          artefatos_bootstrap_existentes: verdadeiro
          texto_publico_sem_mojibake: verdadeiro
          skill_portatil_global_oficial: verdadeiro
          skill_agents_canonica: verdadeiro
          skill_claude_espelho_gerenciado: verdadeiro
          workspace_entrypoint_unico_agents_md: verdadeiro
          cache_plugin_intocado: verdadeiro
        }
      }
    }
  }
}

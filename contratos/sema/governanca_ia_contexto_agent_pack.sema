module sema.produto.governanca_ia.contexto.agent_pack {
  docs {
    resumo: "Geracao do Agent Context Pack oficial para Codex, com regras canonicas e evidencias locais antes de abrir codigo cru, sem autorizacao, licenca, credito, token ou painel."
  }

  task gerar_agent_context_pack {
    input {
      guiaPorCapacidade: Objeto required
    }
    output {
      nome: Texto
      versao: Numero
      objetivo: Texto
      ordemLeitura: Lista
      regrasObrigatorias: Lista
      proibicoes: Lista
      prioridades: Lista
      fontes: Lista
      descoberta: Objeto
      exemplosOficiais: Lista
      textoBrutoSobDemanda: Objeto
      guiaPorCapacidade: Objeto
      aliasesCapacidade: Objeto
      entrypointCodex: Texto
      codexNativo: Booleano
      cliLocalSemAutorizacao: Booleano
      politicaIdioma: Objeto
      politicaCodigoGovernado: Objeto
      politicaTimeoutResumo: Objeto
      politicaDesignVisual: Objeto
      politicaPlataforma: Objeto
      failClosed: Lista
    }
    rules {
      guiaPorCapacidade deve_ser preenchido
      guiaPorCapacidade deve_ser incluir_fraca
      guiaPorCapacidade deve_ser incluir_pequena
      guiaPorCapacidade deve_ser incluir_media
      guiaPorCapacidade deve_ser incluir_forte
      guiaPorCapacidade deve_ser incluir_grande
      guiaPorCapacidade deve_ser incluir_descricao_artefatos_ordemLeitura_e_evitar_por_capacidade
    }
    effects {
      fs.write contexto_ia criticidade = media
      auditoria agent_context_pack criticidade = media
    }
    authz {
      escopo: sema.contexto.agent_pack
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        guiaPorCapacidade: interno
      }
      output {
        nome: publico
        versao: publico
        objetivo: publico
        ordemLeitura: publico
        regrasObrigatorias: publico
        proibicoes: publico
        prioridades: publico
        fontes: publico
        descoberta: publico
        exemplosOficiais: publico
        textoBrutoSobDemanda: interno
        guiaPorCapacidade: publico
        aliasesCapacidade: publico
        entrypointCodex: publico
        codexNativo: publico
        cliLocalSemAutorizacao: publico
        politicaIdioma: publico
        politicaCodigoGovernado: publico
        politicaTimeoutResumo: publico
        politicaDesignVisual: publico
        politicaPlataforma: publico
        failClosed: publico
      }
    }
    audit {
      evento: sema.ia.agent_context_pack
      ator: agente.sema
      correlacao: request_id
      retencao: "90d"
      motivo: obrigatorio
    }
    forbidden {
      esconder_agents_md_do_agente
      esconder_exemplos_quando_criar_contrato
      abrir_codigo_cru_antes_de_contexto_canonico
      misturar_repositorio_publico_e_privado_sem_regra
      traduzir_palavras_chave_dsl
      usar_estetica_ascii_da_dsl_para_texto_humano
      remover_acentos_em_resposta_ptbr_por_causa_da_dsl
      depender_apenas_de_agents_md_para_ia_fraca
      dizer_que_codigo_foi_verificado_quando_so_contrato_foi_enviado
      extrapolar_snapshot_selecionado_para_repositorio_inteiro
      remover_cabecalho_sema_governado_de_codigo
      comentario_ruidoso_que_duplica_contrato_inteiro
      descricao_humana_sem_idioma_do_usuario
      tratar_timeout_do_agente_como_falha_sema
      avancar_codigo_apos_timeout_sem_retry
      usar_sema_como_bypass_de_politica_da_plataforma
      tratar_bloqueio_plataforma_como_falha_sema
      tentar_burlar_filtro_plataforma
      exigir_preflight_de_autorizacao_local
      exigir_chave_licenca_token_credito_ou_painel
      gerar_matriz_de_entrypoints_para_clientes_nao_codex
      citar_artefato_inexistente_como_leitura_obrigatoria
      ensinar_nome_de_tool_mcp_em_workspace_cli_local
      passar_check_por_palavra_chave_sem_evidencia
      tratar_score_regex_como_prova_semantica_suficiente
      tratar_validacao_inline_como_dispensa_de_cabecalho_codigo
      aumentar_timeout_para_payload_acima_limite_inline
      fatiar_arquivo_em_partes_sem_responsabilidade_real
      culpar_limite_500_por_arquitetura_monolitica_escolhida
      confundir_caminho_remoto_com_workspace_local_do_usuario
    }
    impl {
      ts: cli.src.agent_context_pack.criarAgentContextPack
    }
    vinculos {
      arquivo: "pacotes/cli/src/agentContextPack.ts"
      arquivo: "pacotes/cli/src/agentContextTipos.ts"
      arquivo: "pacotes/cli/src/discovery/index.ts"
      arquivo: "scripts/empacotar-cli-publica.mjs"
      arquivo: "scripts/testar-pacote-cli-publico.mjs"
      arquivo: "scripts/cli-publico/bootstrap-codex.mjs"
      simbolo: cli.src.agent_context_pack.criarAgentContextPack
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "120s"
      retry: "progressivo_por_timeout_local"
      compensacao: "regenerar entrypoint Codex e contexto IA-first"
      criticidade_operacional: media
    }
    guarantees {
      nome existe
      versao == 7
      objetivo existe
      ordemLeitura existe
      regrasObrigatorias existe
      proibicoes existe
      prioridades existe
      fontes existe
      descoberta existe
      exemplosOficiais existe
      exemplosOficiais deve_ser incluir_profile_simulation_e_definicoes_interativas_retro_headless_3d_e_protocolo_adapter
      textoBrutoSobDemanda existe
      guiaPorCapacidade existe
      aliasesCapacidade existe
      entrypointCodex existe
      codexNativo == verdadeiro
      cliLocalSemAutorizacao == verdadeiro
      politicaIdioma existe
      politicaCodigoGovernado existe
      politicaTimeoutResumo existe
      politicaDesignVisual existe
      politicaPlataforma existe
      failClosed existe
    }
    tests {
      caso "gera pack a partir do guia completo por capacidade" {
        given {
          guiaPorCapacidade: "fraca, pequena, media, forte e grande com descricao, artefatos, ordemLeitura e evitar"
        }

        expect {
          sucesso: verdadeiro
          versao: 7
          descoberta: "sema.discovery/v1"
          entrypointCodex: "AGENTS.md"
          codexNativo: verdadeiro
          cliLocalSemAutorizacao: verdadeiro
        }
      }
    }
  }
}

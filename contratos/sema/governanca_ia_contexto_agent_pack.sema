module sema.produto.governanca_ia.contexto.agent_pack {
  docs {
    resumo: "Geracao do Agent Context Pack, regras canonicas e evidencias que guiam agentes antes de abrir codigo cru."
  }

  task gerar_agent_context_pack {
    input {
      base_projeto: Texto required
      capacidade_ia: Texto required
      fontes_disponiveis: Texto
      timeout_local: Texto
    }
    output {
      agent_context_pack: Texto
      regras_obrigatorias: Texto
      proibicoes: Texto
      prioridades: Texto
      fontes_citadas: Texto
      tiers_operacionais: Texto
      entrypoints_clientes: Texto
      politica_idioma_humano: Texto
      fail_closed: Texto
      exemplos_visiveis: Booleano
      texto_bruto_sob_demanda: Booleano
      keywords_canonicas_explicitas: Booleano
      escopo_evidencia_explicitado: Booleano
      conclusao_codigo_bloqueada_quando_nao_verificado: Booleano
      proxima_acao_verificacao: Texto
      cabecalho_codigo_governado: Texto
      comentarios_codigo_por_capacidade: Texto
      descricao_humana_codigo: Texto
      politica_timeout_resumo: Texto
      retry_timeout_progressivo: Booleano
      politica_plataforma: Texto
      bloqueio_plataforma_tratado_como_externo: Booleano
      politica_sinal_vs_ritual: Texto
      divisao_por_responsabilidade: Texto
      prova_inline_nao_substitui_cabecalho: Texto
      politica_payload_inline: Texto
      contexto_local_sem_espelho: Texto
    }
    rules {
      base_projeto deve_ser preenchido
      capacidade_ia deve_ser em [fraca, media, forte, pequena, grande]
      fontes_disponiveis deve_ser incluir_agents_md
      fontes_disponiveis deve_ser incluir_exemplos_oficiais
      fontes_disponiveis deve_ser lembrar_keywords_canonicas
      fontes_disponiveis deve_ser declarar_modo_verificacao_codigo
      fontes_disponiveis deve_ser separar_contrato_valido_de_codigo_verificado
      fontes_disponiveis deve_ser incluir_sema_boot
      fontes_disponiveis deve_ser incluir_politica_idioma_humano
      fontes_disponiveis deve_ser incluir_cabecalho_sema_codigo
      fontes_disponiveis deve_ser incluir_descricao_humana_codigo
      fontes_disponiveis deve_ser cobrir_ia_fraca_media_forte
      fontes_disponiveis deve_ser incluir_politica_timeout_resumo
      fontes_disponiveis deve_ser incluir_politica_plataforma
      fontes_disponiveis deve_ser incluir_score_como_sinal_nao_prova_unica
      fontes_disponiveis deve_ser exigir_evidencia_substantiva_alem_de_palavra_chave
      fontes_disponiveis deve_ser incluir_divisao_por_responsabilidade
      fontes_disponiveis deve_ser rejeitar_fatiamento_artificial
      fontes_disponiveis deve_ser explicar_limite_payload_inline
      fontes_disponiveis deve_ser exigir_workspace_local_cli
      timeout_local deve_ser retry_progressivo_antes_de_falha
    }
    effects {
      fs.write contexto_ia criticidade = media
      auditoria agent_context_pack criticidade = media
    }
    authz {
      escopo: sema.contexto.agent_pack
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        base_projeto: interno
        capacidade_ia: interno
        fontes_disponiveis: interno
        timeout_local: interno
      }
      output {
        agent_context_pack: interno
        regras_obrigatorias: publico
        proibicoes: publico
        prioridades: publico
        fontes_citadas: publico
        tiers_operacionais: publico
        entrypoints_clientes: publico
        politica_idioma_humano: publico
        fail_closed: publico
        exemplos_visiveis: publico
        texto_bruto_sob_demanda: publico
        keywords_canonicas_explicitas: publico
        escopo_evidencia_explicitado: publico
        conclusao_codigo_bloqueada_quando_nao_verificado: publico
        proxima_acao_verificacao: publico
        cabecalho_codigo_governado: publico
        comentarios_codigo_por_capacidade: publico
        descricao_humana_codigo: publico
        politica_timeout_resumo: publico
        retry_timeout_progressivo: publico
        politica_plataforma: publico
        bloqueio_plataforma_tratado_como_externo: publico
        politica_sinal_vs_ritual: publico
        divisao_por_responsabilidade: publico
        prova_inline_nao_substitui_cabecalho: publico
        politica_payload_inline: publico
        contexto_local_sem_espelho: publico
      }
    }
    audit {
      evento: sema.ia.agent_context_pack
      ator: agente.sema
      correlacao: request_id
      retencao: "90d"
      motivo: obrigatorio
    }
    forbidden {
      esconder_agents_md_do_agente
      esconder_exemplos_quando_criar_contrato
      abrir_codigo_cru_antes_de_contexto_canonico
      misturar_repositorio_publico_e_privado_sem_regra
      traduzir_palavras_chave_dsl
      usar_estetica_ascii_da_dsl_para_texto_humano
      remover_acentos_em_resposta_ptbr_por_causa_da_dsl
      depender_apenas_de_agents_md_para_ia_fraca
      dizer_que_codigo_foi_verificado_quando_so_contrato_foi_enviado
      extrapolar_snapshot_selecionado_para_repositorio_inteiro
      remover_cabecalho_sema_governado_de_codigo
      comentario_ruidoso_que_duplica_contrato_inteiro
      descricao_humana_sem_idioma_do_usuario
      tratar_timeout_do_agente_como_falha_sema
      avancar_codigo_apos_timeout_sem_retry
      usar_sema_como_bypass_de_politica_da_plataforma
      tratar_bloqueio_plataforma_como_falha_sema
      tentar_burlar_filtro_plataforma
      fingir_acesso_ia_ao_painel_para_instalar_cli
      passar_check_por_palavra_chave_sem_evidencia
      tratar_score_regex_como_prova_semantica_suficiente
      tratar_validacao_inline_como_dispensa_de_cabecalho_codigo
      aumentar_timeout_para_payload_acima_limite_inline
      fatiar_arquivo_em_partes_sem_responsabilidade_real
      culpar_limite_500_por_arquitetura_monolitica_escolhida
      confundir_caminho_remoto_com_workspace_local_do_usuario
    }
    impl {
      ts: cli.src.agent_context_pack.criarAgentContextPack
    }
    vinculos {
      arquivo: "pacotes/cli/src/agentContextPack.ts"
      arquivo: "pacotes/cli/src/agentContextTipos.ts"
      arquivo: "scripts/empacotar-cli-publica.mjs"
      arquivo: "scripts/testar-pacote-cli-publico.mjs"
      simbolo: cli.src.agent_context_pack.criarAgentContextPack
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "120s"
      retry: "progressivo_por_timeout_local"
      compensacao: "regenerar entrypoints IA-first"
      criticidade_operacional: media
    }
    guarantees {
      agent_context_pack existe
      regras_obrigatorias existe
      proibicoes existe
      prioridades existe
      fontes_citadas existe
      tiers_operacionais existe
      entrypoints_clientes existe
      politica_idioma_humano existe
      politica_idioma_humano deve_ser preservar_idioma_do_usuario
      politica_idioma_humano deve_ser preservar_acentos_ptbr
      fail_closed existe
      tiers_operacionais deve_ser mapear_alias_pequena_para_fraca
      tiers_operacionais deve_ser mapear_alias_grande_para_forte
      exemplos_visiveis == verdadeiro
      texto_bruto_sob_demanda == verdadeiro
      keywords_canonicas_explicitas == verdadeiro
      escopo_evidencia_explicitado == verdadeiro
      conclusao_codigo_bloqueada_quando_nao_verificado == verdadeiro
      proxima_acao_verificacao existe
      cabecalho_codigo_governado existe
      cabecalho_codigo_governado deve_ser lembrar_chamar_sema
      comentarios_codigo_por_capacidade deve_ser cobrir_fraca_media_forte
      descricao_humana_codigo deve_ser preservar_idioma_do_usuario
      politica_timeout_resumo existe
      politica_timeout_resumo deve_ser distinguir_lentidao_de_falha_sema
      retry_timeout_progressivo == verdadeiro
      politica_plataforma existe
      politica_plataforma deve_ser explicita_para_ia_fraca_media_forte
      politica_plataforma deve_ser declarar_que_sema_nao_contorna_politicas
      bloqueio_plataforma_tratado_como_externo == verdadeiro
      politica_sinal_vs_ritual existe
      politica_sinal_vs_ritual deve_ser orientar_evidencia_concreta
      divisao_por_responsabilidade existe
      divisao_por_responsabilidade deve_ser proibir_fatiamento_artificial
      prova_inline_nao_substitui_cabecalho existe
      politica_payload_inline deve_ser cobrir_fraca_media_forte
      contexto_local_sem_espelho existe
    }
    tests {
      caso "agente recebe regras fontes e exemplos antes de codigo" {
        given {
          base_projeto: "."
          capacidade_ia: "media"
          fontes_disponiveis: "llms.txt AGENT_CONTEXT_PACK.json SEMA_INDEX.json AGENTS.md exemplos/ politica_plataforma"
        }
        expect {
          sucesso: verdadeiro
          exemplos_visiveis: verdadeiro
          texto_bruto_sob_demanda: verdadeiro
          keywords_canonicas_explicitas: verdadeiro
          escopo_evidencia_explicitado: verdadeiro
          conclusao_codigo_bloqueada_quando_nao_verificado: verdadeiro
          retry_timeout_progressivo: verdadeiro
          bloqueio_plataforma_tratado_como_externo: verdadeiro
        }
      }
      caso "agente fraco recebe boot e idioma humano preservado" {
        given {
          base_projeto: "."
          capacidade_ia: "fraca"
          fontes_disponiveis: "SEMA_BOOT.md SEMA_SMALL_MODEL.md AGENT_CONTEXT_PACK.json SEMA_INDEX.json AGENTS.md sema_exemplos politica_idioma_humano politica_plataforma"
        }
        expect {
          sucesso: verdadeiro
          exemplos_visiveis: verdadeiro
          texto_bruto_sob_demanda: verdadeiro
          keywords_canonicas_explicitas: verdadeiro
          retry_timeout_progressivo: verdadeiro
          bloqueio_plataforma_tratado_como_externo: verdadeiro
        }
      }
      caso "codigo governado lembra todos os niveis de ia" {
        given {
          base_projeto: "."
          capacidade_ia: "forte"
          fontes_disponiveis: "SEMA_BOOT.md SEMA_SMALL_MODEL.md AGENT_CONTEXT_PACK.json docs/ai-integration.md cabecalho_sema_codigo descricao_humana_codigo politica_plataforma fraca media forte"
        }
        expect {
          sucesso: verdadeiro
          exemplos_visiveis: verdadeiro
          texto_bruto_sob_demanda: verdadeiro
          keywords_canonicas_explicitas: verdadeiro
          retry_timeout_progressivo: verdadeiro
          bloqueio_plataforma_tratado_como_externo: verdadeiro
        }
      }
    }
  }
}

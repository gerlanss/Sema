module sema.produto.governanca_ia.contexto.entrypoints {
  docs {
    resumo: "Sincronizacao do entrypoint oficial do Codex para governanca Sema local. O protocolo tenta a CLI no PATH por conveniencia e usa o launcher global absoluto como fallback antes de declarar indisponibilidade; a skill permanece limitada ao bootstrap e reparo, sem duplicar AGENTS.md nem gerar matriz de clientes."
  }

  use sema.produto.distribuicao_global

  task sincronizar_entrypoint_codex {
    input {
      base_projeto: Texto required
      capacidade_padrao: Texto
    }
    output {
      sema_boot: Texto
      sema_small_model: Texto
      agents_md: Texto
      docs_sintaxe: Texto
      docs_fluxo_pratico: Texto
      docs_comandos: Texto
      codex_entrypoint: Texto
      codex_nativo: Booleano
      cli_local_sem_autorizacao: Booleano
      entrypoints_legados_limpos: Booleano
      entrypoints_legados_pendentes: Lista
      skill_bootstrap_codex_documentada: Booleano
      idioma_humano_preservado: Booleano
      retry_timeout_progressivo: Booleano
      politica_plataforma_explicita: Booleano
      politica_sinal_vs_ritual_explicita: Booleano
      divisao_por_responsabilidade_explicita: Booleano
      contexto_local_sem_espelho: Booleano
      destinos_entrypoint_prevalidados: Booleano
      politica_modos_drift_explicita: Booleano
      launcher_global_fallback_documentado: Booleano
      cli_indisponivel_somente_apos_fallback: Booleano
      skill_global_delega_agents_md: Booleano
    }
    rules {
      base_projeto deve_ser preenchido
      capacidade_padrao deve_ser em [fraca, media, forte]
    }
    effects {
      fs.write entrypoint_codex criticidade = media
      auditoria sync_codex_entrypoint criticidade = media
    }
    authz {
      escopo: sema.codex.entrypoint.write
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        base_projeto: interno
        capacidade_padrao: publico
      }
      output {
        sema_boot: publico
        sema_small_model: publico
        agents_md: publico
        docs_sintaxe: publico
        docs_fluxo_pratico: publico
        docs_comandos: publico
        codex_entrypoint: publico
        codex_nativo: publico
        cli_local_sem_autorizacao: publico
        entrypoints_legados_limpos: publico
        entrypoints_legados_pendentes: publico
        skill_bootstrap_codex_documentada: publico
        idioma_humano_preservado: publico
        retry_timeout_progressivo: publico
        politica_plataforma_explicita: publico
        politica_sinal_vs_ritual_explicita: publico
        divisao_por_responsabilidade_explicita: publico
        contexto_local_sem_espelho: publico
        destinos_entrypoint_prevalidados: publico
        politica_modos_drift_explicita: publico
        launcher_global_fallback_documentado: publico
        cli_indisponivel_somente_apos_fallback: publico
        skill_global_delega_agents_md: publico
      }
    }
    audit {
      evento: sema.codex.entrypoint_sincronizado
      ator: agente.sema
      correlacao: request_id
      retencao: "90d"
      motivo: obrigatorio
    }
    forbidden {
      gerar_entrypoint_para_cliente_nao_codex
      omitir_skill_de_bootstrap_antes_de_agents_md
      duplicar_governanca_do_agents_md_na_skill
      exigir_preflight_de_autorizacao_local
      exigir_chave_licenca_token_credito_ou_painel
      sobrescrever_customizacao_manual_sem_bloco_gerenciado
      apagar_configuracao_local_fora_do_bloco_gerenciado
      declarar_limpo_com_entrypoint_legado_pendente
      pedir_para_runtime_remoto_ler_pasta_local
      instruir_ia_fraca_com_documento_longo_primeiro
      omitir_politica_de_idioma
      omitir_retry_timeout_progressivo
      tratar_timeout_do_agente_como_falha_sema
      omitir_politica_plataforma
      instruir_bypass_de_politica_da_plataforma
      omitir_politica_sinal_vs_ritual
      sugerir_fatiamento_artificial_de_arquivo
      dispensar_cabecalho_por_validacao_inline
      tratar_path_linux_remoto_como_pasta_local_do_usuario
      citar_artefato_nao_materializado_no_bootstrap
      ensinar_nome_de_tool_mcp_em_protocolo_cli_local
      escrever_entrypoint_antes_de_prevalidar_todos_os_destinos
      declarar_cli_indisponivel_apos_apenas_falha_de_PATH
      ensinar_dependencia_exclusiva_de_PATH
      apontar_fallback_para_shim_npm_ou_cache_de_plugin
      duplicar_governanca_do_agents_md_na_skill_global
    }
    impl {
      ts: cli.src.index_part06.comandoSyncCodex
    }
    vinculos {
      arquivo: "pacotes/cli/src/agentEntryPoints.ts"
      arquivo: "pacotes/cli/src/index.part06.ts"
      arquivo: "pacotes/cli/src/distribuicao/launcherGlobal.ts"
      arquivo: "pacotes/cli/src/distribuicao/index.ts"
      arquivo: "testes/integracao/codex_runtime.test.ts"
      arquivo: "testes/unidade/distribuicao-launcher-global.test.ts"
      simbolo: cli.src.index_part06.comandoSyncCodex
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "120s"
      retry: "progressivo_por_timeout_local"
      compensacao: "regenerar entrypoint oficial do Codex"
      criticidade_operacional: media
    }
    guarantees {
      sema_boot existe
      sema_boot deve_ser primeiro_entrypoint
      sema_small_model existe
      sema_small_model deve_ser compacto_para_ia_fraca
      agents_md existe
      docs_sintaxe existe
      docs_fluxo_pratico existe
      docs_comandos existe
      codex_entrypoint existe
      codex_nativo == verdadeiro
      cli_local_sem_autorizacao == verdadeiro
      entrypoints_legados_limpos == verdadeiro
      entrypoints_legados_pendentes deve_ser vazio
      skill_bootstrap_codex_documentada == verdadeiro
      idioma_humano_preservado == verdadeiro
      retry_timeout_progressivo == verdadeiro
      politica_plataforma_explicita == verdadeiro
      politica_sinal_vs_ritual_explicita == verdadeiro
      divisao_por_responsabilidade_explicita == verdadeiro
      contexto_local_sem_espelho == verdadeiro
      politica_modos_drift_explicita == verdadeiro
      launcher_global_fallback_documentado == verdadeiro
      cli_indisponivel_somente_apos_fallback == verdadeiro
      skill_global_delega_agents_md == verdadeiro
      agents_md deve_ser referenciar_somente_artefatos_materializados
      destinos_entrypoint_prevalidados == verdadeiro
      agents_md deve_ser usar_comandos_cli_locais
      sema_boot deve_ser usar_comandos_cli_locais
      agents_md deve_ser distinguir_consulta_none_de_drift_fresh
      sema_boot deve_ser distinguir_consulta_none_de_drift_fresh
      sema_small_model deve_ser distinguir_consulta_none_de_drift_fresh
      docs_comandos deve_ser distinguir_consulta_none_de_drift_fresh
    }
    tests {
      caso "sincroniza apenas o entrypoint oficial do Codex" {
        given {
          base_projeto: "."
          capacidade_padrao: "media"
        }

        expect {
          sucesso: verdadeiro
          codex_nativo: verdadeiro
          cli_local_sem_autorizacao: verdadeiro
          entrypoints_legados_limpos: verdadeiro
          entrypoints_legados_pendentes: ""
          skill_bootstrap_codex_documentada: verdadeiro
          idioma_humano_preservado: verdadeiro
          retry_timeout_progressivo: verdadeiro
          politica_plataforma_explicita: verdadeiro
          agents_md: verdadeiro
          docs_sintaxe: verdadeiro
          docs_comandos: verdadeiro
          politica_modos_drift_explicita: verdadeiro
          launcher_global_fallback_documentado: verdadeiro
          cli_indisponivel_somente_apos_fallback: verdadeiro
          skill_global_delega_agents_md: verdadeiro
        }
      }
    }
  }
}

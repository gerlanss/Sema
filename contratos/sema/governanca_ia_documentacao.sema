module sema.produto.governanca_ia.documentacao {
  docs {
    resumo: "Resolve documentacao obrigatoria e agrega localizacao e evidencia de finalizacao."
    arquivo: "contratos/sema/governanca_ia_documentacao_localizacao.sema"
    arquivo: "contratos/sema/governanca_ia_documentacao_finalizacao.sema"
    arquivo: "docs/documentation.md"
  }

  use sema.produto.governanca_ia.documentacao.localizacao

  use sema.produto.governanca_ia.documentacao.finalizacao

  task resolver_documentacao_obrigatoria_para_mudanca {
    input {
      base_projeto: Texto required
      intencao: Texto required
      arquivos_alvo: Texto
      criar_ausentes: Booleano required
    }
    output {
      docs_obrigatorias_resolvidas: Booleano
      leitura_obrigatoria_emitida: Booleano
      docs_ausentes_detectadas: Booleano
      docs_criadas_quando_autorizado: Booleano
      docs_criadas_sao_esqueleto: Booleano
      escopo_documental_preciso: Booleano
      tokens_genericos_ignorados: Booleano
    }
    rules {
      arquivos_alvo deve_ser usados_com_nome_relevante
      arquivos_alvo deve_ser sem_tokens_de_diretorio_genericos
      intencao deve_ser usada_para_filtrar_contratos
      criar_ausentes deve_ser preflight_integral_antes_de_fs_write
    }
    authz {
      escopo: sema.docs.resolver
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        base_projeto: interno
        intencao: interno
        arquivos_alvo: interno
        criar_ausentes: interno
      }
      output {
        docs_obrigatorias_resolvidas: interno
        leitura_obrigatoria_emitida: interno
        docs_ausentes_detectadas: interno
        docs_criadas_quando_autorizado: interno
        docs_criadas_sao_esqueleto: interno
        escopo_documental_preciso: interno
        tokens_genericos_ignorados: interno
      }
    }
    audit {
      evento: sema.docs.impacto_resolvido
      ator: agente.sema
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      relacionar_contrato_por_token_generico_sema
      relacionar_contrato_por_pasta_contratos
      exigir_catalogo_inteiro_por_arquivo_em_contratos_sema
      usar_token_de_diretorio_comum_como_match
      criar_documento_antes_de_validar_todos_os_destinos
      seguir_symlink_ou_junction_em_documentacao
    }
    impl {
      ts: cli.src.docs.resolverDocumentacaoObrigatoria
    }
    vinculos {
      arquivo: "pacotes/cli/src/docs.part02.ts"
      arquivo: "pacotes/cli/src/index.part04.ts"
      arquivo: "pacotes/cli/src/workspaceWrite.ts"
      arquivo: "testes/integracao/docs-impacto-seguro.test.ts"
      arquivo: "pacotes/cli/src/docs.ts"
      arquivo: "pacotes/cli/src/index.ts"
      simbolo: cli.src.docs.resolverDocumentacaoObrigatoria
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "criar documento ausente antes da acao"
      criticidade_operacional: alta
    }
    guarantees {
      docs_obrigatorias_resolvidas existe
      leitura_obrigatoria_emitida existe
      docs_ausentes_detectadas existe
      docs_criadas_quando_autorizado existe
      docs_criadas_sao_esqueleto == verdadeiro
      escopo_documental_preciso == verdadeiro
      tokens_genericos_ignorados == verdadeiro
    }
    error {
      documentacao_ausente {
        mensagem: documentacao obrigatoria nao encontrada para a intencao declarada
        categoria: negocio
        recuperabilidade: permanente
        acao_chamador: corrigir
        impacta_estado: falso
        requer_compensacao: falso
      }
    }
    tests {
      caso "deploy exige docs operacionais antes de agir" {
        given {
          base_projeto: "."
          intencao: "fazer deploy"
          criar_ausentes: falso
        }

        expect {
          sucesso: verdadeiro
          docs_obrigatorias_resolvidas: verdadeiro
          leitura_obrigatoria_emitida: verdadeiro
        }
      }
      caso "arquivo em contratos sema nao exige catalogo inteiro" {
        given {
          base_projeto: "."
          intencao: "alterar entrypoint de agentes"
          arquivos_alvo: "contratos/sema/governanca_ia_contexto.sema pacotes/cli/src/index.ts"
          criar_ausentes: falso
        }

        expect {
          sucesso: verdadeiro
          escopo_documental_preciso: verdadeiro
          tokens_genericos_ignorados: verdadeiro
        }
      }
    }
  }
}

module sema.produto.governanca_ia.documentacao {
  docs {
    resumo: "Contrato filho para documentacao obrigatoria, localizacao e leitura documental antes da mudanca."
  }

  task resolver_documentacao_obrigatoria_para_mudanca {
    input {
      base_projeto: Texto required
      intencao: Texto required
      arquivos_alvo: Texto
      criar_ausentes: Booleano required
    }
    output {
      docs_obrigatorias_resolvidas: Booleano
      leitura_obrigatoria_emitida: Booleano
      docs_ausentes_detectadas: Booleano
      docs_criadas_quando_autorizado: Booleano
      docs_criadas_sao_esqueleto: Booleano
      escopo_documental_preciso: Booleano
      tokens_genericos_ignorados: Booleano
    }
    rules {
      arquivos_alvo deve_ser usados_com_nome_relevante
      arquivos_alvo deve_ser sem_tokens_de_diretorio_genericos
      intencao deve_ser usada_para_filtrar_contratos
      criar_ausentes deve_ser preflight_integral_antes_de_fs_write
    }
    authz {
      escopo: sema.docs.resolver
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        base_projeto: interno
        intencao: interno
        arquivos_alvo: interno
        criar_ausentes: interno
      }
      output {
        docs_obrigatorias_resolvidas: interno
        leitura_obrigatoria_emitida: interno
        docs_ausentes_detectadas: interno
        docs_criadas_quando_autorizado: interno
        docs_criadas_sao_esqueleto: interno
        escopo_documental_preciso: interno
        tokens_genericos_ignorados: interno
      }
    }
    audit {
      evento: sema.docs.impacto_resolvido
      ator: agente.sema
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      relacionar_contrato_por_token_generico_sema
      relacionar_contrato_por_pasta_contratos
      exigir_catalogo_inteiro_por_arquivo_em_contratos_sema
      usar_token_de_diretorio_comum_como_match
      criar_documento_antes_de_validar_todos_os_destinos
      seguir_symlink_ou_junction_em_documentacao
    }
    impl {
      ts: cli.src.docs.resolverDocumentacaoObrigatoria
    }
    vinculos {
      arquivo: "pacotes/cli/src/docs.part02.ts"
      arquivo: "pacotes/cli/src/workspaceWrite.ts"
      arquivo: "testes/integracao/docs-impacto-seguro.test.ts"
      arquivo: "pacotes/cli/src/docs.ts"
      arquivo: "pacotes/cli/src/index.ts"
      simbolo: cli.src.docs.resolverDocumentacaoObrigatoria
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "criar documento ausente antes da acao"
      criticidade_operacional: alta
    }
    guarantees {
      docs_obrigatorias_resolvidas existe
      leitura_obrigatoria_emitida existe
      docs_ausentes_detectadas existe
      docs_criadas_quando_autorizado existe
      docs_criadas_sao_esqueleto == verdadeiro
      escopo_documental_preciso == verdadeiro
      tokens_genericos_ignorados == verdadeiro
    }
    error {
      documentacao_ausente {
        mensagem: documentacao obrigatoria nao encontrada para a intencao declarada
        categoria: negocio
        recuperabilidade: permanente
        acao_chamador: corrigir
        impacta_estado: falso
        requer_compensacao: falso
      }
    }
    tests {
      caso "deploy exige docs operacionais antes de agir" {
        given {
          base_projeto: "."
          intencao: "fazer deploy"
          criar_ausentes: falso
        }

        expect {
          sucesso: verdadeiro
          docs_obrigatorias_resolvidas: verdadeiro
          leitura_obrigatoria_emitida: verdadeiro
        }
      }
      caso "arquivo em contratos sema nao exige catalogo inteiro" {
        given {
          base_projeto: "."
          intencao: "alterar entrypoint de agentes"
          arquivos_alvo: "contratos/sema/governanca_ia_contexto.sema pacotes/cli/src/index.ts"
          criar_ausentes: falso
        }

        expect {
          sucesso: verdadeiro
          escopo_documental_preciso: verdadeiro
          tokens_genericos_ignorados: verdadeiro
        }
      }
    }
  }

  task publicar_documentacao_localizada {
    input {
      documentos: Texto required
      idiomas_solicitados: Lista required
      ordem_idiomas: Texto
      idioma_padrao: Texto
      publico_alvo: Texto required
      superficie: Texto required
    }
    output {
      portugues_com_acentos: Booleano
      espanhol_com_acentos: Booleano
      idiomas_solicitados_cobertos: Booleano
      quantidade_idiomas_variavel: Booleano
      texto_visivel_no_idioma_do_usuario: Booleano
      documentacao_privada_ptbr_permitida: Booleano
      docs_com_suporte_multilingue: Booleano
      github_npm_alinhados: Booleano
      descricao_npm_publica: Booleano
      geracao_futura_preserva_i18n: Booleano
      exemplos_codigo_preservados: Booleano
      identificadores_tecnicos_preservados: Booleano
    }
    rules {
      documentos deve_ser preenchido
      idiomas_solicitados deve_ser nao_vazio
      publico_alvo deve_ser em [agente, operador, publico, interno]
      superficie deve_ser preenchida
    }
    effects {
      fs.write documentacao_governada criticidade = media
      auditoria documentacao_localizada criticidade = media
    }
    authz {
      escopo: sema.docs.i18n
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: parcial
      input {
        documentos: publico
        idiomas_solicitados: publico
        ordem_idiomas: publico
        idioma_padrao: publico
        publico_alvo: publico
        superficie: publico
      }
      output {
        portugues_com_acentos: publico
        espanhol_com_acentos: publico
        idiomas_solicitados_cobertos: publico
        quantidade_idiomas_variavel: publico
        texto_visivel_no_idioma_do_usuario: publico
        documentacao_privada_ptbr_permitida: publico
        docs_com_suporte_multilingue: publico
        github_npm_alinhados: publico
        descricao_npm_publica: publico
        geracao_futura_preserva_i18n: publico
        exemplos_codigo_preservados: publico
        identificadores_tecnicos_preservados: publico
      }
    }
    audit {
      evento: sema.docs.i18n_localizada
      ator: agente.sema
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      documentacao_publica_monolingue_quando_multiplos_idiomas_solicitados
      idioma_solicitado_ausente
      idioma_do_usuario_ignorado
      portugues_sem_acentos
      espanhol_sem_acentos
      documentacao_privada_com_ingles_ou_espanhol_sem_pedido
      idiomas_hardcoded_como_quantidade_fixa
      quantidade_idiomas_fixa_sem_pedido
      ordem_idiomas_inventada
      texto_ascii_por_padrao_em_idioma_com_acento
      mojibake_em_texto_humano
      caractere_substituicao_em_texto_humano
      evento_tecnico_cru_como_rotulo_principal
      readme_npm_desalinhado_do_github
      publicar_npm_com_readme_antigo
      descricao_npm_sem_idioma_externo_quando_publico
      sobrescrever_exemplo_de_codigo_por_traducao
      traduzir_identificador_tecnico_sem_intencao
    }
    impl {
      ts: cli.src.docs.criarTemplateDoc
    }
    vinculos {
      arquivo: "README.md"
      arquivo: "docs/README.md"
      arquivo: "docs/documentation.md"
      arquivo: "docs/i18n.md"
      arquivo: "pacotes/cli/README.md"
      arquivo: "pacotes/cli/package.json"
      arquivo: "pacotes/cli/src/docs.ts"
      simbolo: cli.src.docs.criarTemplateDoc
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "restaurar documento anterior se i18n quebrar links ou exemplos"
      criticidade_operacional: media
    }
    guarantees {
      portugues_com_acentos == verdadeiro
      idiomas_solicitados_cobertos == verdadeiro
      quantidade_idiomas_variavel == verdadeiro
      texto_visivel_no_idioma_do_usuario == verdadeiro
      documentacao_privada_ptbr_permitida == verdadeiro
      github_npm_alinhados == verdadeiro
      geracao_futura_preserva_i18n == verdadeiro
      exemplos_codigo_preservados == verdadeiro
      identificadores_tecnicos_preservados == verdadeiro
    }
    error {
      i18n_documental_incompleto {
        mensagem: documentacao precisa seguir a superficie declarada e usar PT-BR privado por padrao e cobrir idiomas solicitados quando externos e preservar acentos e nao inventar quantidade fixa
        categoria: negocio
        recuperabilidade: permanente
        acao_chamador: corrigir
        impacta_estado: falso
        requer_compensacao: falso
      }
    }
    tests {
      caso "texto publico cobre idiomas solicitados sem fixar quantidade" {
        given {
          documentos: "README.md docs/README.md docs/documentation.md pacotes/cli/README.md"
          idiomas_solicitados: "Português, Español, Français"
          ordem_idiomas: "Português Español Français"
          idioma_padrao: "Português"
          publico_alvo: "publico"
          superficie: "docs site app painel admin"
        }

        expect {
          sucesso: verdadeiro
          portugues_com_acentos: verdadeiro
          espanhol_com_acentos: verdadeiro
          idiomas_solicitados_cobertos: verdadeiro
          quantidade_idiomas_variavel: verdadeiro
          texto_visivel_no_idioma_do_usuario: verdadeiro
          docs_com_suporte_multilingue: verdadeiro
          github_npm_alinhados: verdadeiro
          descricao_npm_publica: verdadeiro
          geracao_futura_preserva_i18n: verdadeiro
          exemplos_codigo_preservados: verdadeiro
          identificadores_tecnicos_preservados: verdadeiro
        }
      }
      caso "readme privado pode ser somente ptbr" {
        given {
          documentos: "README.md docs/README.md docs/documentation.md docs/i18n.md"
          idiomas_solicitados: "Português"
          ordem_idiomas: "Português"
          idioma_padrao: "Português"
          publico_alvo: "interno"
          superficie: "repositorio privado"
        }

        expect {
          sucesso: verdadeiro
          portugues_com_acentos: verdadeiro
          idiomas_solicitados_cobertos: verdadeiro
          quantidade_idiomas_variavel: verdadeiro
          texto_visivel_no_idioma_do_usuario: verdadeiro
          documentacao_privada_ptbr_permitida: verdadeiro
          github_npm_alinhados: verdadeiro
          geracao_futura_preserva_i18n: verdadeiro
          exemplos_codigo_preservados: verdadeiro
          identificadores_tecnicos_preservados: verdadeiro
        }
      }
    }
  }

  task validar_leitura_documental_da_mudanca {
    input {
      base_projeto: Texto required
      intencao: Texto required
      arquivos_alvo: Texto
      docs_lidas: Texto
      docs_criadas: Texto
      docs_editadas: Texto
      docs_removidas: Texto
      docs_sem_impacto: Texto
      sem_impacto_doc: Texto
    }
    output {
      docs_obrigatorias_lidas: Booleano
      docs_impactadas_cobertas: Booleano
      decisao_documental_comprovada: Booleano
      documentacao_atualizada_ou_justificada: Booleano
      docs_sem_decisao: Lista
      bloqueio_emitido_quando_falta_leitura: Booleano
      templates_crus_bloqueados: Booleano
      diagnostico_compacto_emitido: Booleano
    }
    authz {
      escopo: sema.docs.finalizar
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        base_projeto: interno
        intencao: interno
        arquivos_alvo: interno
        docs_lidas: interno
        docs_criadas: interno
        docs_editadas: interno
        docs_removidas: interno
        docs_sem_impacto: interno
        sem_impacto_doc: interno
      }
      output {
        docs_obrigatorias_lidas: interno
        docs_impactadas_cobertas: interno
        decisao_documental_comprovada: interno
        documentacao_atualizada_ou_justificada: interno
        docs_sem_decisao: interno
        bloqueio_emitido_quando_falta_leitura: interno
        templates_crus_bloqueados: interno
        diagnostico_compacto_emitido: interno
      }
    }
    audit {
      evento: sema.docs.mudanca_finalizada
      ator: agente.sema
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      retornar_conteudo_documental_no_fechamento
      ocultar_diagnostico_atras_de_contexto_longo
      finalizar_somente_com_doc_lida
      concluir_sem_decisao_documental
      deixar_doc_operacional_relacionada_sem_decisao
      marcar_doc_nao_relacionada_como_evidencia
      usar_sem_impacto_doc_sem_motivo
      usar_motivo_sem_impacto_sem_doc
      finalizar_com_template_cru_criado_pela_sema
    }
    impl {
      ts: cli.src.docs.verificarDocumentacaoMudanca
    }
    vinculos {
      arquivo: "pacotes/cli/src/docs.ts"
      arquivo: "pacotes/cli/src/index.ts"
      simbolo: cli.src.docs.verificarDocumentacaoMudanca
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "ler docs obrigatorias e declarar por arquivo doc criada editada removida ou sem impacto justificado antes de concluir"
      criticidade_operacional: alta
    }
    guarantees {
      docs_obrigatorias_lidas existe
      docs_impactadas_cobertas existe
      decisao_documental_comprovada existe
      documentacao_atualizada_ou_justificada existe
      docs_sem_decisao existe
      docs_sem_decisao deve_ser vazia_quando_sem_impacto_doc_ausente
      bloqueio_emitido_quando_falta_leitura existe
      templates_crus_bloqueados existe
      diagnostico_compacto_emitido existe
      documentacao_atualizada_ou_justificada == verdadeiro
    }
    error {
      leitura_obrigatoria_nao_comprovada {
        mensagem: IA tentou concluir sem comprovar leitura das docs obrigatorias
        categoria: negocio
        recuperabilidade: permanente
        acao_chamador: corrigir
        impacta_estado: falso
        requer_compensacao: falso
      }
      decisao_documental_nao_comprovada {
        mensagem: IA tentou concluir sem declarar se a documentacao foi criada editada removida ou sem impacto justificado
        categoria: negocio
        recuperabilidade: permanente
        acao_chamador: corrigir
        impacta_estado: falso
        requer_compensacao: falso
      }
      documentacao_template_cru {
        mensagem: IA tentou concluir usando esqueleto criado pela Sema sem preencher procedimento validacao e rollback reais
        categoria: negocio
        recuperabilidade: permanente
        acao_chamador: corrigir
        impacta_estado: falso
        requer_compensacao: falso
      }
    }
    tests {
      caso "mudanca nao fecha sem docs lidas" {
        given {
          base_projeto: "."
          intencao: "alterar CLI local"
          docs_lidas: ""
        }

        expect {
          sucesso: verdadeiro
          bloqueio_emitido_quando_falta_leitura: verdadeiro
          diagnostico_compacto_emitido: verdadeiro
        }
      }
      caso "mudanca nao fecha somente com doc lida" {
        given {
          base_projeto: "."
          intencao: "alterar painel admin"
          docs_lidas: "AGENTS.md docs/frontend.md docs/i18n.md"
        }

        expect {
          sucesso: verdadeiro
          decisao_documental_comprovada: falso
          documentacao_atualizada_ou_justificada: falso
        }
      }
      caso "mudanca fecha com doc editada declarada" {
        given {
          base_projeto: "."
          intencao: "alterar painel admin"
          docs_lidas: "AGENTS.md docs/frontend.md docs/i18n.md"
          docs_editadas: "docs/frontend.md"
          docs_sem_impacto: "docs/i18n.md"
          sem_impacto_doc: "continua valida para esta mudanca"
        }

        expect {
          sucesso: verdadeiro
          decisao_documental_comprovada: verdadeiro
          documentacao_atualizada_ou_justificada: verdadeiro
        }
      }
    }
  }
}

module sema.produto.governanca_ia.documentacao.finalizacao {
  docs {
    resumo: "Confere declaracoes documentais com escopo persistido e hashes sem alegar prova de compreensao ou comportamento."
    arquivo: "contratos/sema/governanca_ia_documentacao.sema"
    arquivo: "docs/documentation.md"
  }

  task validar_leitura_documental_da_mudanca {
    input {
      base_projeto: Texto required
      intencao: Texto required
      arquivos_alvo: Texto
      docs_lidas: Texto
      mudanca_id: Texto
    }
    output {
      docs_obrigatorias_lidas: Booleano
      bloqueio_emitido_quando_falta_leitura: Booleano
      templates_crus_bloqueados: Booleano
      docs_sem_substancia_bloqueadas: Booleano
      leitura_recomendada_nao_bloqueia_fechamento: Booleano
      diagnostico_compacto_emitido: Booleano
    }
    authz {
      escopo: sema.docs.finalizar
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
    }
    audit {
      evento: sema.docs.mudanca_finalizada
      ator: agente.sema
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      retornar_conteudo_documental_no_fechamento
      ocultar_diagnostico_atras_de_contexto_longo
      tratar_declaracao_com_hash_como_prova_de_leitura_ou_compreensao
      tratar_gate_documental_como_execucao_de_validar_drift_ou_testes
      finalizar_cli_sem_id_ou_arquivos_explicitos
      trocar_intencao_ou_reduzir_arquivos_do_id
      reutilizar_declaracao_de_documento_alterado_ou_removido
      aceitar_doc_lida_inexistente_ou_fora_do_workspace
      finalizar_com_template_cru_criado_pela_sema
      finalizar_com_doc_sem_substancia
      bloquear_fechamento_por_leitura_recomendada
    }
    impl {
      ts: cli.src.docs.verificarDocumentacaoMudanca
    }
    vinculos {
      arquivo: "pacotes/cli/src/docs.ts"
      arquivo: "pacotes/cli/src/docs.part02.ts"
      arquivo: "pacotes/cli/src/index.part04.ts"
      arquivo: "pacotes/cli/src/changeScope.ts"
      arquivo: "pacotes/cli/src/changeCommands.ts"
      arquivo: "testes/unidade/fluxo-ia-regressao.test.ts"
      simbolo: cli.src.docs.verificarDocumentacaoMudanca
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "retomar mudanca_id ler documentos pendentes e declarar apenas leituras efetivas"
      criticidade_operacional: alta
    }
    guarantees {
      docs_obrigatorias_lidas deve_ser declaracao_do_agente_nao_prova_de_compreensao
      bloqueio_emitido_quando_falta_leitura existe
      templates_crus_bloqueados existe
      docs_sem_substancia_bloqueadas existe
      leitura_recomendada_nao_bloqueia_fechamento existe
      diagnostico_compacto_emitido deve_ser incluir_id_escopo_e_proximas_chamadas_completas
      diagnostico_compacto_emitido deve_ser preservar_codigo_legado_leitura_obrigatoria_nao_comprovada
    }
    error {
      leitura_obrigatoria_nao_comprovada {
        mensagem: IA tentou fechar sem declarar documentos obrigatorios lidos
        categoria: negocio
        recuperabilidade: permanente
        acao_chamador: corrigir
        impacta_estado: falso
        requer_compensacao: falso
      }
    }
    tests {
      caso "mudanca nao fecha sem docs declaradas" {
        given {
          base_projeto: "."
          intencao: "alterar CLI local"
          docs_lidas: ""
        }

        expect {
          sucesso: verdadeiro
          bloqueio_emitido_quando_falta_leitura: verdadeiro
          diagnostico_compacto_emitido: verdadeiro
        }
      }
    }
  }
}

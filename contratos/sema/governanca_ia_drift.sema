module sema.produto.governanca_ia.drift {
  docs {
    resumo: "Mede drift contra codigo vivo, agrega impacto e renomeacao semantica e delega o cache persistente seguro a uma capacidade propria."
    arquivo: "contratos/sema/governanca_ia_drift_cache.sema"
    arquivo: "contratos/sema/governanca_ia_drift_mudancas.sema"
    arquivo: "docs/ai-workflow.md"
  }

  use sema.produto.governanca_ia.drift.cache

  use sema.produto.governanca_ia.drift.mudancas

  task medir_drift_contra_codigo_vivo {
    input {
      contrato_alvo: Texto required
      codigo_vivo: Texto required
      escopo_real: Texto required
      alvo_explicito: Booleano required
      ignorar_worktrees: Booleano required
      ignorar_consumidores_laterais: Booleano required
      modo_cache: Texto required
    }
    output {
      impls_resolvidas: Booleano
      rotas_resolvidas: Booleano
      rotas_node_resolvidas: Booleano
      score_pesando_comportamento_verificado: Booleano
      ambiguidades_explicitas: Booleano
      escopo_aplicado: Booleano
      escopo_estreito_sem_alvo_bloqueado: Booleano
      ruido_lateral_reduzido: Booleano
      consumer_surfaces_priorizadas: Booleano
      persistencia_local_classificada: Booleano
      simbolos_sql_resolvidos: Booleano
      arquivos_documentais_resolvidos: Booleano
      superficies_publicas_resolvidas: Booleano
      vinculos_fora_do_escopo_informativos: Booleano
      planejamento_antes_catalogo: Booleano
      catalogo_compartilhado: Booleano
      metricas_operacionais_expostas: Booleano
      cobertura_dependencias_completa: Booleano
      cache_fora_workspace: Booleano
      resultado_equivalente_sem_cache: Booleano
      zero_mutacao_workspace_por_cache: Booleano
    }
    rules {
      contrato_alvo deve_ser informado
      escopo_real deve_ser projeto_ou_alvo_explicitado
      alvo_explicito deve_ser verdadeiro quando escopo_real em [arquivo, modulo]
      modo_cache deve_ser em [none, cache, fresh]
    }
    authz {
      escopo: sema.drift.executar
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        contrato_alvo: interno
        codigo_vivo: interno
        escopo_real: interno
        alvo_explicito: interno
        ignorar_worktrees: interno
        ignorar_consumidores_laterais: interno
        modo_cache: publico
      }
      output {
        impls_resolvidas: interno
        rotas_resolvidas: interno
        rotas_node_resolvidas: interno
        score_pesando_comportamento_verificado: interno
        ambiguidades_explicitas: interno
        escopo_aplicado: interno
        escopo_estreito_sem_alvo_bloqueado: interno
        ruido_lateral_reduzido: interno
        consumer_surfaces_priorizadas: interno
        persistencia_local_classificada: interno
        simbolos_sql_resolvidos: interno
        arquivos_documentais_resolvidos: interno
        superficies_publicas_resolvidas: interno
        vinculos_fora_do_escopo_informativos: interno
        planejamento_antes_catalogo: interno
        catalogo_compartilhado: interno
        metricas_operacionais_expostas: interno
        cobertura_dependencias_completa: interno
        cache_fora_workspace: interno
        resultado_equivalente_sem_cache: interno
        zero_mutacao_workspace_por_cache: interno
      }
    }
    audit {
      evento: sema.drift.executado
      ator: agente.sema
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      executar_drift_modulo_sem_contrato_alvo
      executar_drift_arquivo_sem_contrato_alvo
      varrer_projeto_inteiro_com_escopo_estreito
      tratar_ruido_global_como_diagnostico_util
      tratar_funcao_sql_declarada_como_vinculo_quebrado
      tratar_documentacao_existente_como_arquivo_inexistente
      tratar_superficie_publica_sincronizada_como_vinculo_quebrado
      catalogar_codigo_antes_de_planejar_escopo_fisico
      reabrir_mesma_fonte_em_indexadores_ou_orcamento
      varrer_codigo_antes_do_plano_em_escopo_estreito
      resolver_impl_homonima_por_ordem_de_arquivos
      inferir_ancora_em_raiz_lateral_sem_vinculo
      expor_caminho_absoluto_fora_do_workspace
      ler_arquivo_com_hardlink_sem_identidade_unica
      concluir_sucesso_com_dependencia_local_ausente
      tratar_simbolo_python_importado_como_modulo_ausente_quando_modulo_pai_resolve
      tratar_vinculo_fisico_explicito_fora_da_raiz_codigo_como_inexistente
      tratar_cache_como_evidencia_final_de_drift
      escrever_cache_em_tmp_sema_cache_ou_qualquer_pasta_do_workspace
      mudar_resultado_funcional_por_hit_miss_corrupcao_ou_indisponibilidade_do_cache
    }
    impl {
      ts: cli.src.drift.analisarDriftLegado
    }
    vinculos {
      arquivo: "pacotes/cli/src/drift.ts"
      arquivo: "pacotes/cli/src/angular-consumer-standalone.ts"
      arquivo: "pacotes/cli/src/drift.part04.ts"
      arquivo: "testes/unidade/drift-score-evidencia.test.ts"
      arquivo: "pacotes/cli/src/drift.part05.ts"
      arquivo: "pacotes/cli/src/drift.part06.ts"
      arquivo: "pacotes/cli/src/drift.part07.ts"
      arquivo: "pacotes/cli/src/drift.part08.ts"
      arquivo: "pacotes/cli/src/drift.part11.ts"
      arquivo: "pacotes/cli/src/drift.part13.ts"
      arquivo: "pacotes/cli/src/drift.part14.ts"
      arquivo: "pacotes/cli/src/drift.part09.ts"
      arquivo: "pacotes/cli/src/typescript-http-rotas.ts"
      arquivo: "pacotes/cli/src/driftEscopo.ts"
      arquivo: "pacotes/cli/src/driftEscopoReferencias.ts"
      arquivo: "pacotes/cli/src/driftCatalogo.ts"
      arquivo: "pacotes/cli/src/projetoCarregar.ts"
      arquivo: "pacotes/cli/src/projetoOrigens.ts"
      arquivo: "pacotes/cli/src/projetoTipos.ts"
      arquivo: "pacotes/cli/src/index.part05.ts"
      arquivo: "testes/integracao/drift-escopo-io.test.ts"
      arquivo: "testes/integracao/drift-caminhos-externos.test.ts"
      arquivo: "testes/unidade/drift-catalogo.test.ts"
      arquivo: "testes/unidade/drift-escopo-dependencias.test.ts"
      arquivo: "testes/unidade/drift-escopo-referencias.test.ts"
      arquivo: "testes/unidade/drift-vinculo-fora-do-escopo.test.ts"
      arquivo: "testes/unidade/drift-leitura-compartilhada.test.ts"
      arquivo: "testes/unidade/drift-rotas-express-fastify.test.ts"
      arquivo: "testes/unidade/projeto-carregamento-escopo.test.ts"
      simbolo: cli.src.drift.analisarDriftLegado
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "30s"
      retry: "3x exponencial"
      compensacao: "reanalisar contexto"
      criticidade_operacional: alta
    }
    guarantees {
      impls_resolvidas existe
      rotas_resolvidas existe
      rotas_node_resolvidas existe
      score_pesando_comportamento_verificado existe
      ambiguidades_explicitas existe
      escopo_aplicado existe
      escopo_estreito_sem_alvo_bloqueado existe
      ruido_lateral_reduzido existe
      consumer_surfaces_priorizadas existe
      persistencia_local_classificada existe
      simbolos_sql_resolvidos existe
      arquivos_documentais_resolvidos existe
      superficies_publicas_resolvidas existe
      vinculos_fora_do_escopo_informativos == verdadeiro
      planejamento_antes_catalogo existe
      catalogo_compartilhado existe
      metricas_operacionais_expostas existe
      cobertura_dependencias_completa existe
      cache_fora_workspace == verdadeiro
      resultado_equivalente_sem_cache == verdadeiro
      zero_mutacao_workspace_por_cache == verdadeiro
    }
    error {
      simbolo_ambiguo {
        mensagem: codigo vivo com simbolo candidato demais
        categoria: infraestrutura
        recuperabilidade: temporaria
        acao_chamador: retry
        impacta_estado: falso
        requer_compensacao: falso
      }
      contrato_alvo_nao_informado {
        mensagem: drift estreito exige contrato alvo explicito
        categoria: contrato
        recuperabilidade: imediata
        acao_chamador: informar_contrato_alvo_ou_usar_escopo_projeto
        impacta_estado: falso
        requer_compensacao: falso
      }
    }
    tests {
      caso "drift guia edicao real" {
        given {
          contrato_alvo: "contratos/sema/*.sema"
          codigo_vivo: "pacotes/**/*.ts"
          escopo_real: "modulo"
          alvo_explicito: verdadeiro
          ignorar_worktrees: verdadeiro
          ignorar_consumidores_laterais: verdadeiro
          modo_cache: "none"
        }

        expect {
          sucesso: verdadeiro
          impls_resolvidas: verdadeiro
          escopo_aplicado: "modulo"
          escopo_estreito_sem_alvo_bloqueado: verdadeiro
          simbolos_sql_resolvidos: verdadeiro
          arquivos_documentais_resolvidos: verdadeiro
          superficies_publicas_resolvidas: verdadeiro
          planejamento_antes_catalogo: verdadeiro
          catalogo_compartilhado: verdadeiro
          metricas_operacionais_expostas: verdadeiro
          cobertura_dependencias_completa: verdadeiro
          cache_fora_workspace: verdadeiro
          resultado_equivalente_sem_cache: verdadeiro
          zero_mutacao_workspace_por_cache: verdadeiro
        }
      }
      caso "vinculo documental em modulo publico resolve" {
        given {
          contrato_alvo: "contratos/sema/persistencia_vendor_first.sema"
          codigo_vivo: "pacotes/**/*.ts docs/*.md"
          escopo_real: "modulo"
          alvo_explicito: verdadeiro
          ignorar_worktrees: verdadeiro
          ignorar_consumidores_laterais: verdadeiro
          modo_cache: "fresh"
        }

        expect {
          sucesso: verdadeiro
          simbolos_sql_resolvidos: verdadeiro
          arquivos_documentais_resolvidos: verdadeiro
        }
      }
      caso "cli bloqueia drift estreito sem contrato alvo" {
        given {
          contrato_alvo: ""
          codigo_vivo: "./workspace-local/projeto"
          escopo_real: "modulo"
          alvo_explicito: falso
          ignorar_worktrees: verdadeiro
          ignorar_consumidores_laterais: verdadeiro
          modo_cache: "none"
        }

        expect {
          sucesso: falso
          escopo_estreito_sem_alvo_bloqueado: verdadeiro
        }
      }
      caso "vinculo fisico fora dos diretoriosCodigo e informativo" {
        given {
          contrato_alvo: "contratos/sema/governanca_ia_drift.sema"
          codigo_vivo: "app_consumer/lib/ponte.dart"
          escopo_real: "projeto"
          alvo_explicito: falso
          ignorar_worktrees: verdadeiro
          ignorar_consumidores_laterais: verdadeiro
          modo_cache: "fresh"
        }

        expect {
          sucesso: verdadeiro
          vinculos_fora_do_escopo_informativos: verdadeiro
          resultado_equivalente_sem_cache: verdadeiro
        }
      }
    }
  }
}

module sema.produto.governanca_ia.release_profiles {
  docs {
    resumo: "Contrato filho para distribuicao npm publica local-only e refinamentos de profiles para agentes."
  }

  task verificar_distribuicao_publica {
    input {
      versao_esperada: Texto required
      repositorio: Texto required
    }
    output {
      manifestos_alinhados: Booleano
      npm_alinhado: Booleano
      github_release_ausente: Booleano
      assets_release_ausentes: Booleano
      ferramentas_locais_alinhadas: Booleano
      sinais_distribuicao_emitidos: Booleano
      repositorio_publico_confirmado: Booleano
      github_head_alinhado: Booleano
      plugin_codex_remoto_consultado: Booleano
      plugin_codex_remoto_instalado: Booleano
      skill_codex_remota_alinhada: Booleano
      plugin_codex_logo_oficial_alinhada: Booleano
      plugin_codex_remoto_sem_mcp: Booleano
      drift_consumidores_laterais_incluido: Booleano
    }
    rules {
      versao_esperada deve_ser preenchido
      versao_esperada deve_ser lida_dos_manifestos_por_validadores_de_status_sem_literal_de_release_fixado
      repositorio deve_ser preenchido
    }
    effects {
      consulta npm_registry criticidade = media
      consulta github_api criticidade = media
      consulta marketplace_codex_remoto criticidade = media
      auditoria instalador_npm criticidade = media
      auditoria plugin_codex_remoto criticidade = media
      auditoria bloqueio_release_publica criticidade = media
    }
    authz {
      escopo: sema.release.verificar
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: parcial
      input {
        versao_esperada: publico
        repositorio: publico
      }
      output {
        manifestos_alinhados: publico
        npm_alinhado: publico
        github_release_ausente: publico
        assets_release_ausentes: publico
        ferramentas_locais_alinhadas: interno
        sinais_distribuicao_emitidos: publico
        repositorio_publico_confirmado: publico
        github_head_alinhado: publico
        plugin_codex_remoto_consultado: publico
        plugin_codex_remoto_instalado: publico
        skill_codex_remota_alinhada: publico
        plugin_codex_logo_oficial_alinhada: publico
        plugin_codex_remoto_sem_mcp: publico
        drift_consumidores_laterais_incluido: publico
      }
    }
    audit {
      evento: sema.release.distribuicao_verificada
      ator: agente.sema
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      afirmar_estado_github_sem_consulta_real
      publicar_github_release_ou_asset_sem_mudar_contrato
      tratar_repositorio_publico_oficial_como_ausente
      aprovar_plugin_codex_sem_instalacao_remota_isolada
      aprovar_skill_remota_divergente_da_fonte_versionada
      aprovar_logo_remota_divergente_da_marca_oficial
      registrar_mcp_sema_durante_instalacao_do_plugin
      fixar_versao_publica_em_scripts_de_status
      aprovar_drift_publico_sem_consumidores_laterais
    }
    impl {
      ts: scripts.verificar_distribuicao_publica.verificarDistribuicaoPublica
    }
    vinculos {
      arquivo: "scripts/verificar-distribuicao-publica.mjs"
      arquivo: "scripts/verificar-versao-release.mjs"
      arquivo: "scripts/check-status.mjs"
      simbolo: scripts.verificar_distribuicao_publica.verificarDistribuicaoPublica
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "180s"
      retry: "manual"
      compensacao: "corrigir instalador npm antes de anunciar instalacao"
      criticidade_operacional: alta
    }
    guarantees {
      manifestos_alinhados existe
      npm_alinhado existe
      github_release_ausente == verdadeiro
      assets_release_ausentes == verdadeiro
      ferramentas_locais_alinhadas existe
      sinais_distribuicao_emitidos existe
      repositorio_publico_confirmado == verdadeiro
      github_head_alinhado == verdadeiro
      plugin_codex_remoto_consultado == verdadeiro
      plugin_codex_remoto_instalado == verdadeiro
      skill_codex_remota_alinhada == verdadeiro
      plugin_codex_logo_oficial_alinhada == verdadeiro
      plugin_codex_remoto_sem_mcp == verdadeiro
      drift_consumidores_laterais_incluido == verdadeiro
    }
    error {
      instalador_npm_desalinhado: "README, npm, manifestos ou CLI local nao batem com a versao esperada."
      release_publica_encontrada: "GitHub Release ou asset publico apareceu sem mudanca previa deste contrato."
      estado_github_nao_verificado: "Nao foi possivel confirmar ao vivo o repositorio oficial e a ausencia de releases/assets."
      plugin_codex_remoto_invalido: "O marketplace remoto nao instalou a skill oficial alinhada ou registrou MCP inesperado."
      drift_publico_incompleto: "O gate de release ignorou consumidores laterais e pode reprovar vinculos validos do showcase."
    }
    tests {
      caso "instalador npm 2.2.0 alinhado sem GitHub Release" {
        given {
          versao_esperada: "2.2.0"
          repositorio: "gerlanss/Sema"
        }

        expect {
          sucesso: verdadeiro
          manifestos_alinhados: verdadeiro
          npm_alinhado: verdadeiro
          github_release_ausente: verdadeiro
          assets_release_ausentes: verdadeiro
          repositorio_publico_confirmado: verdadeiro
          github_head_alinhado: verdadeiro
          plugin_codex_remoto_consultado: verdadeiro
          plugin_codex_remoto_instalado: verdadeiro
          skill_codex_remota_alinhada: verdadeiro
          plugin_codex_logo_oficial_alinhada: verdadeiro
          plugin_codex_remoto_sem_mcp: verdadeiro
          drift_consumidores_laterais_incluido: verdadeiro
        }
      }
    }
  }

  task rastrear_refinamentos_profiles_agentes {
    input {
      critica_ia: Texto required
      profiles_afetados: Lista required
    }
    output {
      roadmap: Texto
      tarefas_rastreaveis: Lista
      ordem_execucao: Lista
      profiles_especializados: Lista
      severidade_padronizada: Lista
      maturidade_padronizada: Lista
      presets_especializados: Lista
      artefato_real_validado: Booleano
      capability_matrix: Lista
      confidence_engine: Objeto
      runtime_gate: Objeto
      rule_packs: Lista
      decisao_agente: Texto
      pronto_para_execucao: Booleano
    }
    rules {
      critica_ia deve_ser preenchida
      profiles_afetados deve_ser nao_vazio
    }
    effects {
      fs.write docs criticidade = baixa
      auditoria roadmap_refinamento_profiles criticidade = media
    }
    authz {
      escopo: sema.governanca.roadmap
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: livre
    }
    audit {
      evento: sema.governanca.roadmap_refinamento
      ator: auth.agente
      correlacao: request_id
      retencao: "90d"
      motivo: obrigatorio
    }
    forbidden {
      roadmap_sem_checklist
      esconder_profile_especializado
      concluir_sem_riscar_tarefa
      tratar_author_como_unico_profile
      profile_sem_severidade_ou_maturidade
      profile_sem_capability_matrix
      score_unico_sem_confidence_engine
      release_sem_caminho_github_publicavel
      concluir_sem_validar_artefato_real_quando_fornecido
      concluir_sem_presets_especializados
    }
    impl {
      ts: cli.src.index.validarProfileSemantico
    }
    vinculos {
      arquivo: "docs/agent-profile-refinements.md"
      arquivo: "docs/profiles.md"
      arquivo: "pacotes/cli/src/index.ts"
      simbolo: cli.src.index.validarProfileSemantico
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "manual"
      criticidade_operacional: media
    }
    guarantees {
      roadmap existe
      roadmap deve_ser arquivo_markdown
      tarefas_rastreaveis existe
      tarefas_rastreaveis deve_ser checklist_atualizavel
      ordem_execucao existe
      ordem_execucao deve_ser priorizada
      profiles_especializados existe
      profiles_especializados deve_ser explicitos
      severidade_padronizada existe
      maturidade_padronizada existe
      presets_especializados existe
      artefato_real_validado existe
      capability_matrix existe
      confidence_engine existe
      runtime_gate existe
      rule_packs existe
      decisao_agente em [continuar, continuar_com_ressalva, parar, chamar_humano]
      pronto_para_execucao == verdadeiro
    }
    tests {
      caso "roadmap lista profiles especializados" {
        given {
          critica_ia: "Author falha em proibicao literal, profiles precisam maturidade."
          profiles_afetados: "author, software, workflow, ops, legal, research, game"
        }

        expect {
          sucesso: verdadeiro
          pronto_para_execucao: verdadeiro
        }
      }
    }
  }
}

module sema.produto.orcamento_semantico {
  docs {
    resumo: "Impede que .sema e codigo governado virem monolitos. Codigo avisa acima de 1000 linhas e bloqueia acima de 2000. Contrato .sema avisa acima de 300, bloqueia criacao/edicao acima de 500, deve ser dividido por dominio/capacidade, nunca parte_1/parte_2. Varios .sema podem governar o mesmo arquivo via vinculos."
    arquivo: "pacotes/nucleo/src/semantico/analisador.ts"
    arquivo: "pacotes/cli/src/drift.ts"
    arquivo: "docs/documentation.md"
    arquivo: "docs/testing.md"
  }

  task diagnosticar_contrato_monolitico {
    input {
      contrato_alvo: Texto required
      linhas: Inteiro required
      tasks: Inteiro required
      entities: Inteiro required
      blocos_operacionais: Inteiro required
    }
    output {
      diagnostico_emitido: Booleano
      severidade: Texto
      limite_aviso_linhas: Inteiro
      limite_bloqueio_linhas: Inteiro
      precisa_refatorar: Booleano
      contrato_indice_sugerido: Booleano
    }
    rules {
      contrato_alvo deve_ser arquivo_sema
      linhas deve_ser menor_que_orcamento_semantico_de_contrato
      tasks deve_ser poucas_por_contexto
      entities deve_ser poucas_por_contexto
      blocos_operacionais deve_ser coesos
    }
    effects {
      auditoria contrato_monolitico_detectado criticidade = media
    }
    impl {
      ts: nucleo.src.semantico.orcamento_semantico.emitirDiagnosticosContratoMonolitico
    }
    vinculos {
      arquivo: "pacotes/nucleo/src/semantico/orcamentoSemantico.ts"
      simbolo: nucleo.src.semantico.orcamento_semantico.emitirDiagnosticosContratoMonolitico
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "5s"
      retry: "nenhum"
      compensacao: "diagnostico aciona refatoracao assistida do contrato e dos arquivos vinculados"
      criticidade_operacional: media
    }
    guarantees {
      diagnostico_emitido existe
      severidade existe
      limite_aviso_linhas existe
      limite_bloqueio_linhas existe
      precisa_refatorar existe
      contrato_indice_sugerido existe
    }
    error {
      contrato_monolitico: "Contrato grande demais para uma IA operar com precisão."
    }
    tests {
      caso "contrato perto do limite gera aviso" {
        given {
          contrato_alvo: "contratos/sema/modulo_crescendo.sema"
          linhas: 350
          tasks: 4
          entities: 2
          blocos_operacionais: 8
        }

        expect {
          sucesso: verdadeiro
          diagnostico_emitido: verdadeiro
          severidade: "aviso"
          precisa_refatorar: falso
        }
      }
      caso "contrato com muitas linhas ou tasks bloqueia" {
        given {
          contrato_alvo: "contratos/sema/modulo_grande.sema"
          linhas: 501
          tasks: 12
          entities: 2
          blocos_operacionais: 16
        }

        expect {
          sucesso: verdadeiro
          diagnostico_emitido: verdadeiro
          severidade: "erro"
          precisa_refatorar: verdadeiro
        }
      }
    }
  }

  task diagnosticar_codigo_monolitico {
    input {
      arquivo_codigo: Texto required
      linhas: Inteiro required
      simbolos: Inteiro required
    }
    output {
      diagnostico_emitido: Booleano
      severidade: Texto
      limite_aviso_linhas: Inteiro
      limite_bloqueio_linhas: Inteiro
      precisa_refatorar_codigo: Booleano
      precisa_revisar_contrato_vinculado: Booleano
    }
    rules {
      arquivo_codigo deve_ser codigo_vivo
      linhas deve_ser menor_que_orcamento_semantico
      simbolos deve_ser poucos_por_responsabilidade
    }
    effects {
      auditoria codigo_monolitico_detectado criticidade = media
    }
    impl {
      ts: cli.src.drift_orcamento.emitirDiagnosticosCodigoMonolitico
    }
    vinculos {
      arquivo: "pacotes/cli/src/driftOrcamento.ts"
      simbolo: cli.src.drift_orcamento.emitirDiagnosticosCodigoMonolitico
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "diagnostico aciona refatoracao assistida do codigo e dos contratos vinculados"
      criticidade_operacional: media
    }
    guarantees {
      diagnostico_emitido existe
      severidade existe
      limite_aviso_linhas existe
      limite_bloqueio_linhas existe
      precisa_refatorar_codigo existe
      precisa_revisar_contrato_vinculado existe
    }
    error {
      codigo_monolitico: "Arquivo de código grande demais para uma IA operar com precisão."
    }
    tests {
      caso "arquivo de codigo perto do limite gera aviso" {
        given {
          arquivo_codigo: "src/app.ts"
          linhas: 1100
          simbolos: 42
        }

        expect {
          sucesso: verdadeiro
          diagnostico_emitido: verdadeiro
          severidade: "aviso"
          precisa_refatorar_codigo: falso
        }
      }
      caso "arquivo de codigo grande bloqueia" {
        given {
          arquivo_codigo: "src/app.ts"
          linhas: 2200
          simbolos: 42
        }

        expect {
          sucesso: verdadeiro
          diagnostico_emitido: verdadeiro
          severidade: "erro"
          precisa_refatorar_codigo: verdadeiro
          precisa_revisar_contrato_vinculado: verdadeiro
        }
      }
    }
  }

  task validar_arquivo_tocado {
    input {
      arquivo: Texto required
      linhas: Inteiro required
      tipo: Texto required
    }
    output {
      permitido: Booleano
      severidade: Texto
      limite_aviso_linhas: Inteiro
      limite_bloqueio_linhas: Inteiro
      mensagem: Texto
    }
    rules {
      arquivo deve_ser arquivo_do_projeto
      linhas deve_ser menor_que_orcamento_semantico
      tipo deve_ser em [contrato, codigo, documentacao, gerado, migracao_historica]
      arquivo deve_ser artefato_deterministico_quando_tipo_gerado
      arquivo deve_ser imutavel_quando_tipo_migracao_historica
    }
    effects {
      auditoria arquivo_tocado_validado criticidade = alta
    }
    authz {
      escopo: sema.orcamento_semantico
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        arquivo: interno
        linhas: publico
        tipo: publico
      }
      output {
        permitido: publico
        severidade: publico
        limite_aviso_linhas: publico
        limite_bloqueio_linhas: publico
        mensagem: interno
      }
    }
    audit {
      evento: sema.orcamento_semantico.arquivo_tocado
      ator: agente.sema
      correlacao: request_id
      retencao: "90d"
      motivo: obrigatorio
    }
    forbidden {
      concluir_mudanca_com_arquivo_monolitico
      tratar_limite_de_linhas_como_sugestao
      criar_ou_editar_contrato_sema_acima_de_500_linhas
      dividir_contrato_em_parte_1_parte_2
      criar_arquivo_grande_para_ia_refatorar_depois
      marcar_codigo_humano_como_gerado_para_fugir_do_gate
      editar_migracao_historica_para_fugir_do_gate
      ocultar_excecao_gerado_acima_do_limite
      abandonar_arquivo_sem_contrato_sem_verificar_e_semantizar
    }
    impl {
      ts: cli.src.drift_orcamento.validarArquivoTocado
    }
    vinculos {
      arquivo: "pacotes/cli/src/driftOrcamento.ts"
      simbolo: cli.src.drift_orcamento.validarArquivoTocado
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "5s"
      retry: "nenhum"
      compensacao: "dividir arquivo antes de concluir mudanca"
      criticidade_operacional: alta
    }
    guarantees {
      permitido existe
      severidade existe
      limite_aviso_linhas existe
      limite_bloqueio_linhas existe
      mensagem existe
      mensagem deve_ser explicita_quando_tipo_gerado_acima_do_limite
    }
    error {
      arquivo_monolitico_bloqueado: "Arquivo tocado passou do limite de linhas e precisa ser dividido antes de concluir; contrato .sema bloqueia acima de 500 linhas."
    }
    tests {
      caso "arquivo tocado acima do limite bloqueia" {
        given {
          arquivo: "src/app.ts"
          linhas: 2200
          tipo: "codigo"
        }

        expect {
          sucesso: verdadeiro
          permitido: falso
          severidade: "erro"
        }
      }
      caso "artefato gerado acima do limite nao bloqueia" {
        given {
          arquivo: "generated/app/grande.ts"
          linhas: 2200
          tipo: "gerado"
        }

        expect {
          sucesso: verdadeiro
          permitido: verdadeiro
          severidade: "ok"
        }
      }
      caso "migration historica aplicada nao bloqueia drift de legado" {
        given {
          arquivo: "database/migrations/20260520223000_admin_console.sql"
          linhas: 953
          tipo: "migracao_historica"
        }

        expect {
          sucesso: verdadeiro
          permitido: verdadeiro
          severidade: "ok"
        }
      }
      caso "documentacao markdown grande nao entra no limite de codigo" {
        given {
          arquivo: "README.md"
          linhas: 5000
          tipo: "documentacao"
        }

        expect {
          sucesso: verdadeiro
          permitido: verdadeiro
          severidade: "ok"
        }
      }
    }
  }

  task validar_cabecalho_codigo_governado {
    input {
      arquivo_codigo: Texto required
      possui_cabecalho_sema: Booleano required
      possui_descricao_humana: Booleano required
    }
    output {
      permitido: Booleano
      mensagem: Texto
      exemplo_cabecalho: Texto
      cobertura_ia_fraca_media_forte: Booleano
    }
    rules {
      arquivo_codigo deve_ser codigo_vivo
      possui_cabecalho_sema deve_ser verdadeiro
      possui_descricao_humana deve_ser verdadeiro
    }
    effects {
      auditoria cabecalho_codigo_governado_validado criticidade = alta
    }
    authz {
      escopo: sema.orcamento_semantico
      tenant: opcional
    }
    dados {
      classificacao_padrao: interno
      redacao_log: parcial
      input {
        arquivo_codigo: interno
        possui_cabecalho_sema: publico
        possui_descricao_humana: publico
      }
      output {
        permitido: publico
        mensagem: interno
        cobertura_ia_fraca_media_forte: publico
      }
    }
    audit {
      evento: sema.orcamento_semantico.cabecalho_codigo
      ator: agente.sema
      correlacao: request_id
      retencao: "90d"
      motivo: obrigatorio
    }
    forbidden {
      concluir_codigo_governado_sem_sema_governed
      concluir_codigo_governado_sem_descricao_humana
      depender_da_memoria_da_ia_para_lembrar_do_contrato
    }
    impl {
      ts: cli.src.drift_orcamento.validarCabecalhoCodigoGovernado
    }
    vinculos {
      arquivo: "pacotes/cli/src/driftOrcamento.ts"
      simbolo: cli.src.drift_orcamento.validarCabecalhoCodigoGovernado
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "5s"
      retry: "nenhum"
      compensacao: "adicionar cabecalho curto SEMA-GOVERNED antes de concluir"
      criticidade_operacional: alta
    }
    guarantees {
      permitido existe
      mensagem existe
      mensagem deve_ser incluir_exemplo_por_extensao_quando_cabecalho_ausente
      exemplo_cabecalho existe
      cobertura_ia_fraca_media_forte == verdadeiro
    }
    error {
      cabecalho_ausente: "Codigo governado precisa declarar SEMA-GOVERNED e uma descricao humana curta; em HTML use comentario <!-- ... --> com linha Descricao."
    }
  }

  flow refatorar_monolito_semantico {
    alvo: Texto
    etapa contrato usa diagnosticar_contrato_monolitico com contrato_alvo = alvo, linhas = 2200, tasks = 12, entities = 2, blocos_operacionais = 16
    etapa codigo usa diagnosticar_codigo_monolitico com arquivo_codigo = alvo, linhas = 2200, simbolos = 42 depende_de contrato
    etapa arquivo usa validar_arquivo_tocado com arquivo = alvo, linhas = 2200, tipo = codigo depende_de codigo
  }
}

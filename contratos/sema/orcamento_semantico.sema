module sema.produto.orcamento_semantico {
  docs {
    resumo: "Diagnostica monolitos e agrega validacao de arquivos e cabecalhos governados."
    arquivo: "contratos/sema/orcamento_semantico_validacao.sema"
    arquivo: "pacotes/nucleo/src/semantico/analisador.ts"
    arquivo: "pacotes/cli/src/drift.ts"
    arquivo: "docs/documentation.md"
    arquivo: "docs/testing.md"
  }

  use sema.produto.orcamento_semantico.validacao

  task diagnosticar_contrato_monolitico {
    input {
      contrato_alvo: Texto required
      linhas: Inteiro required
      tasks: Inteiro required
      entities: Inteiro required
      blocos_operacionais: Inteiro required
    }
    output {
      diagnostico_emitido: Booleano
      severidade: Texto
      limite_aviso_linhas: Inteiro
      limite_bloqueio_linhas: Inteiro
      precisa_refatorar: Booleano
      contrato_indice_sugerido: Booleano
    }
    rules {
      contrato_alvo deve_ser arquivo_sema
      linhas deve_ser menor_que_orcamento_semantico_de_contrato
      tasks deve_ser poucas_por_contexto
      entities deve_ser poucas_por_contexto
      blocos_operacionais deve_ser coesos
    }
    effects {
      auditoria contrato_monolitico_detectado criticidade = media
    }
    impl {
      ts: nucleo.src.semantico.orcamento_semantico.emitirDiagnosticosContratoMonolitico
    }
    vinculos {
      arquivo: "pacotes/nucleo/src/semantico/orcamentoSemantico.ts"
      simbolo: nucleo.src.semantico.orcamento_semantico.emitirDiagnosticosContratoMonolitico
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "5s"
      retry: "nenhum"
      compensacao: "diagnostico aciona refatoracao assistida do contrato e dos arquivos vinculados"
      criticidade_operacional: media
    }
    guarantees {
      diagnostico_emitido existe
      severidade existe
      limite_aviso_linhas existe
      limite_bloqueio_linhas existe
      precisa_refatorar existe
      contrato_indice_sugerido existe
    }
    error {
      contrato_monolitico: "Contrato grande demais para uma IA operar com precisão."
    }
    tests {
      caso "contrato perto do limite gera aviso" {
        given {
          contrato_alvo: "contratos/sema/modulo_crescendo.sema"
          linhas: 350
          tasks: 4
          entities: 2
          blocos_operacionais: 8
        }

        expect {
          sucesso: verdadeiro
          diagnostico_emitido: verdadeiro
          severidade: "aviso"
          precisa_refatorar: falso
        }
      }
      caso "contrato com muitas linhas ou tasks bloqueia" {
        given {
          contrato_alvo: "contratos/sema/modulo_grande.sema"
          linhas: 501
          tasks: 12
          entities: 2
          blocos_operacionais: 16
        }

        expect {
          sucesso: verdadeiro
          diagnostico_emitido: verdadeiro
          severidade: "erro"
          precisa_refatorar: verdadeiro
        }
      }
    }
  }

  task diagnosticar_codigo_monolitico {
    input {
      arquivo_codigo: Texto required
      linhas: Inteiro required
      simbolos: Inteiro required
    }
    output {
      diagnostico_emitido: Booleano
      severidade: Texto
      limite_aviso_linhas: Inteiro
      limite_bloqueio_linhas: Inteiro
      precisa_refatorar_codigo: Booleano
      precisa_revisar_contrato_vinculado: Booleano
    }
    rules {
      arquivo_codigo deve_ser codigo_vivo
      linhas deve_ser menor_que_orcamento_semantico
      simbolos deve_ser poucos_por_responsabilidade
    }
    effects {
      auditoria codigo_monolitico_detectado criticidade = media
    }
    impl {
      ts: cli.src.drift_orcamento.emitirDiagnosticosCodigoMonolitico
    }
    vinculos {
      arquivo: "pacotes/cli/src/driftOrcamento.ts"
      simbolo: cli.src.drift_orcamento.emitirDiagnosticosCodigoMonolitico
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "diagnostico aciona refatoracao assistida do codigo e dos contratos vinculados"
      criticidade_operacional: media
    }
    guarantees {
      diagnostico_emitido existe
      severidade existe
      limite_aviso_linhas existe
      limite_bloqueio_linhas existe
      precisa_refatorar_codigo existe
      precisa_revisar_contrato_vinculado existe
    }
    error {
      codigo_monolitico: "Arquivo de código grande demais para uma IA operar com precisão."
    }
    tests {
      caso "arquivo de codigo perto do limite gera aviso" {
        given {
          arquivo_codigo: "src/app.ts"
          linhas: 1100
          simbolos: 42
        }

        expect {
          sucesso: verdadeiro
          diagnostico_emitido: verdadeiro
          severidade: "aviso"
          precisa_refatorar_codigo: falso
        }
      }
      caso "arquivo de codigo grande bloqueia" {
        given {
          arquivo_codigo: "src/app.ts"
          linhas: 2200
          simbolos: 42
        }

        expect {
          sucesso: verdadeiro
          diagnostico_emitido: verdadeiro
          severidade: "erro"
          precisa_refatorar_codigo: verdadeiro
          precisa_revisar_contrato_vinculado: verdadeiro
        }
      }
    }
  }

  flow refatorar_monolito_semantico {
    alvo: Texto
    etapa contrato usa diagnosticar_contrato_monolitico com contrato_alvo = alvo, linhas = 2200, tasks = 12, entities = 2, blocos_operacionais = 16
    etapa codigo usa diagnosticar_codigo_monolitico com arquivo_codigo = alvo, linhas = 2200, simbolos = 42 depende_de contrato
    etapa arquivo usa validar_arquivo_tocado com arquivo = alvo, linhas = 2200, tipo = codigo depende_de codigo
  }
}

module sema.produto.sistemas_interativos.operacao.acceptance_evidencias {
  docs {
    resumo: "Valida acceptance locks, invalidacao explicita e descritores multimodais locais nao autoritativos."
    arquivo: "contratos/sema/sistemas_interativos_operacao.sema"
    arquivo: "contratos/sema/sistemas_interativos_evidencias.sema"
    arquivo: "docs/sistemas-interativos.md"
  }

  task operar_acceptance_lock_interativo {
    input {
      operacao: Texto required
      lock: Objeto required
      contexto: Objeto required
    }
    output {
      resultado: Objeto
    }
    rules {
      operacao deve_ser em [VALIDATE, EVALUATE, INVALIDATE]
      lock deve_ser ligado_a_artifact_digest_scene_time_range_approver_e_decision_ACCEPTED
      contexto deve_ser exigir_binding_exato_para_EVALUATE_e_invalidacao_explicita_ligada_ao_lock_digest_para_INVALIDATE
    }
    effects {
      auditoria acceptance_lock_interativo_operado criticidade = media
    }
    forbidden {
      reutilizar_lock_em_artifact_scene_ou_time_range_divergente
      invalidar_implicitamente_ou_sem_ator_motivo_e_lock_digest
      escrever_estado_externo_ou_declarar_aprovacao_autoritativa
    }
    impl {
      ts: cli.src.sistemas_interativos.operations.operarAcceptanceLock
    }
    vinculos {
      arquivo: "pacotes/cli/src/sistemasInterativos/operations.ts"
      arquivo: "pacotes/cli/src/sistemasInterativos/acceptanceEvidence.ts"
      simbolo: cli.src.sistemas_interativos.operations.operarAcceptanceLock
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "5s"
      retry: "nenhum"
      criticidade_operacional: media
    }
    guarantees {
      resultado existe
      resultado deve_ser deterministico_explicito_nao_mutante_e_authoritative_false
    }
  }

  task validar_evidencia_multimodal_operacional {
    input {
      descriptor: Objeto required
    }
    output {
      resultado: Objeto
    }
    rules {
      descriptor deve_ser JSON_v1_ligado_a_claim_id_definition_plan_contract_artifact_scene_time_range_por_claim_binding_digest_canonico
      descriptor deve_ser ter_required_modalities_unicas_e_canais_unicos_em [SCREENSHOT, VIDEO, DEPTH, NORMALS, OBJECT_ID, MOTION, TRANSFORMS, EVENTS, AUDIO, TELEMETRY]
      descriptor deve_ser ter_digest_e_media_type_por_canal_e_identidade_versao_configuracao_de_producer_e_verifier_estruturalmente_distintos
      descriptor deve_ser authoritative_false_e_sem_valor_sensivel_em_qualquer_profundidade
    }
    effects {
      auditoria evidencia_multimodal_operacional_validada criticidade = media
    }
    forbidden {
      capturar_midia_executar_verifier_ou_inferir_canal_ausente
      aceitar_PASS_com_menos_de_duas_modalities_sem_toda_required_modality_sem_claim_binding_ou_sem_producer_verifier_independente_ou_confiar_apenas_em_flag_independent
      ecoar_payload_invalido_ou_tratar_descriptor_como_atestacao_forte
    }
    impl {
      ts: cli.src.sistemas_interativos.operations.validarEvidenciaMultimodal
    }
    vinculos {
      arquivo: "pacotes/cli/src/sistemasInterativos/operations.ts"
      arquivo: "pacotes/cli/src/sistemasInterativos/acceptanceEvidence.ts"
      simbolo: cli.src.sistemas_interativos.operations.validarEvidenciaMultimodal
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "5s"
      retry: "nenhum"
      criticidade_operacional: media
    }
    guarantees {
      resultado existe
      resultado deve_ser local_descriptor_only_executed_false_authoritative_false
    }
  }
}

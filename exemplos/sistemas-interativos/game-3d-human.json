    "interactive.failure.observe",
    "interactive.fidelity.systemic",
    "interactive.kind.game",
    "interactive.playtest.plan",
    "interactive.render.visual",
    "interactive.replay.compare",
    "interactive.runtime.bind",
    "interactive.runtime.observe",
    "interactive.smoke.observe",
    "interactive.spatial.three_d",
    "interactive.state.model",
    "interactive.time.real_time",
    "interactive.visual.realistic",
    "interactive.world.model"

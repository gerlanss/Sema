    "successConditions": [
      "arena.exit reached"
    ],
    "failureConditions": [
      "health reaches zero"
    ],
    "rules": [
      "movement obeys collision volumes",
      "objectives unlock in declared order"
    ]
  },
  "acceptance": {
    "boot": "runtime reaches the playable arena",
    "loop": "a human can complete one full objective cycle",
    "failure": "failure returns to a recoverable checkpoint"
  }

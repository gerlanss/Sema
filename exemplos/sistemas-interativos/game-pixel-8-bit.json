    "step": "one 30 Hz tick"
  },
  "budgets": {
    "paletteColors": 16,
    "baseResolution": "128x128",
    "tileSize": "8x8",
    "spriteSize": "8x8 and 16x16",
    "memoryBudgetBytes": 32768,
    "audioProfile": "four-channel chiptune"
  },
  "acceptance": {
    "pixelIntegrity": "sprites and tiles stay on the integer grid",
    "playability": "the full loop is completable with two buttons and a d-pad"

{
  "schemaVersion": "1.0",
  "systemId": "example.simulation.text.controlled",
  "version": "1.0.0",
  "kind": "SIMULATION",
  "spatialModel": "NON_SPATIAL",
  "renderMode": "TEXT",
  "visualProfile": "NONE",
  "fidelity": "SYSTEMIC",
  "controlModes": [
    "SCRIPTED"
  ],
  "timeModel": "TURN_BASED",
  "determinism": "STRICT",
  "capabilities": [
    "interactive.control.scripted",
    "interactive.determinism.strict",
    "interactive.event.log",
    "interactive.fidelity.systemic",
    "interactive.kind.simulation",
    "interactive.render.text",
    "interactive.replay.compare",
    "interactive.seed.bind",
    "interactive.snapshot.capture",
    "interactive.spatial.non_spatial",
    "interactive.state.model",
    "interactive.time.turn_based",
    "interactive.visual.none",
    "interactive.world.model",
    "simulation.invariants.validate",
    "simulation.model",
    "simulation.outputs.compare",
    "simulation.outputs.observe",
    "simulation.scenario.define",
    "simulation.validity.report"
  ],
  "pipelines": [
    "simulation.scenario",
    "simulation.validate",
    "interactive.replay"
  ],
  "adapterTargets": [
    "runtime.text.generic",
    "simulation.runner.generic",
    "telemetry.trace.local",
    "validator.replay.local"
  ],
  "world": {
    "identity": "turn-based queueing simulation with a text surface",
    "state": {
      "turn": 0,
      "queueLength": 0
    },
    "time": {
      "turnDurationMinutes": 1
    },
    "events": [
      "request.arrive",
      "request.complete",
      "capacity.change"
    ],
    "initialConditions": {
      "servers": 4,
      "queueLength": 0
    },
    "model": "finite-capacity discrete queue",
    "assumptions": [
      "one turn represents one minute"
    ],
    "boundaryConditions": {
      "maximumQueueLength": 1000,
      "turns": 1440
    },
    "outputs": [
      "meanWaitTurns",
      "maximumQueueLength",
      "completedRequests"
    ],
    "validation": {
      "method": "compare seeded turns with queue invariants and expected outputs",
      "invariants": ["queue length remains non-negative", "completed requests do not exceed arrivals"]
    },
    "seed": 2026071905,
    "snapshot": "queue, servers, counters, and random stream",
    "replay": "ordered scripted arrivals and capacity events",
    "step": "one declared turn"
  },
  "acceptance": {
    "textSurface": "every turn can be inspected without a graphical renderer",
    "invariants": [
      "queue length is never negative",
      "completed requests never exceed arrivals"
    ]
  }
}

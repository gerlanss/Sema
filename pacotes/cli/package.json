{
  "name": "@semacode/cli",
  "version": "1.5.54",
  "type": "module",
  "description": "Local semantic governance CLI for AI agents: contracts, drift, impact, documentation gates, and code generation.",
  "license": "SEE LICENSE IN LICENSE",
  "homepage": "https://otimitare.online",
  "bugs": {
    "url": "https://otimitare.online",
    "email": "suporte@otimitare.online"
  },
  "keywords": [
    "sema",
    "ai",
    "contracts",
    "governance",
    "backend",
    "drift",
    "dsl"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {

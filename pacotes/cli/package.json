{
  "name": "@semacode/cli",
  "version": "3.13.1",
  "type": "module",
  "description": "Local-first semantic governance CLI for AI agents, proven with Claude, Codex, zCode (GLM) and Kimi: contracts, drift, impact, docs gates, and code generation.",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gerlanss/Sema.git"
  },
  "homepage": "https://otimitare.com",
  "bugs": {
    "url": "https://github.com/gerlanss/Sema/issues",
    "email": "suporte@otimitare.com"
  },
  "keywords": [
    "sema",
    "ai",
    "codex",
    "ai-agents",
    "semantic-governance",
    "local-first",
    "contracts",
    "governance",
    "backend",
    "drift",
    "dsl"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "icon": "logo.png",
  "bin": {
    "sema": "dist/bin.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "exemplos",
    "skills",
    "scripts/postinstall.mjs",
    "README.md",
    "package.json",
    "logo.png"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "node scripts/bloquear-pack-workspace.mjs",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@sema/nucleo": "file:../nucleo",
    "@sema/gerador-dart": "file:../gerador-dart",
    "@sema/gerador-lua": "file:../gerador-lua",
    "@sema/gerador-python": "file:../gerador-python",
    "@sema/gerador-typescript": "file:../gerador-typescript",
    "@sema/gerador-javascript": "file:../gerador-javascript",
    "@sema/gerador-html": "file:../gerador-html",
    "@sema/gerador-css": "file:../gerador-css",
    "@sema/gerador-php": "file:../gerador-php",
    "@sema/gerador-dotnet": "file:../gerador-dotnet",
    "@sema/gerador-cpp": "file:../gerador-cpp",
    "@sema/padroes": "file:../padroes",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "tsx": "^4.19.3"
  },
  "bundleDependencies": [
    "@sema/nucleo",
    "@sema/padroes",
    "@sema/gerador-typescript",
    "@sema/gerador-python",
    "@sema/gerador-dart",
    "@sema/gerador-lua",
    "@sema/gerador-javascript",
    "@sema/gerador-html",
    "@sema/gerador-css",
    "@sema/gerador-php",
    "@sema/gerador-dotnet",
    "@sema/gerador-cpp"
  ]
}

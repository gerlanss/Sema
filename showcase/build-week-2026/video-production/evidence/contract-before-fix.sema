module sema.showcase.build_week_2026.demo {
  docs {
    resumo: "Demonstra de forma deterministica como o Sema detecta uma renomeacao parcial de approvePayment para confirmPayment, preserva a garantia receipt_id e fecha o drift depois da correcao."
  }

  vinculos {
    arquivo: "README.md"
    arquivo: "sema.config.json"
    arquivo: "demo.mjs"
    arquivo: "prepare-bootstrap.mjs"
    arquivo: "reset.mjs"
    arquivo: "smoke-test.mjs"
    arquivo: ".gitignore"
    arquivo: "lib/bootstrap-state.mjs"
    arquivo: "lib/project-state.mjs"
    arquivo: "lib/scenario.mjs"
    arquivo: "bootstrap-seed/project-before-sema.txt"
    arquivo: "project/src/payment.mjs"
    arquivo: "project/fixtures/payment.baseline.mjs"
    arquivo: "project/fixtures/payment.healthy.mjs"
    arquivo: "project/fixtures/payment.broken.mjs"
    arquivo: "project/test/payment.test.mjs"
    simbolo: payment.approvePayment
    simbolo: lib.bootstrap_state.prepareBootstrapWorkspace
    simbolo: lib.project_state.resetProject
    simbolo: lib.scenario.runScenario
  }
  task approve_payment {
    input {
      payment_id: Texto required
      amount_cents: Inteiro required
    }
    output {
      approved: Booleano
      receipt_id: Texto
    }
    rules {
      payment_id deve_ser preenchido
      amount_cents > 0
    }
    effects {
      auditoria payment approval criticidade = media
    }
    impl {
      js: payment.approvePayment
    }
    vinculos {
      arquivo: "project/src/payment.mjs"
      simbolo: payment.approvePayment
    }
    guarantees {
      approved == verdadeiro
      receipt_id existe
    }
    error {
      payment_invalid: "Payment id must be present and amount_cents must be positive."
    }
    tests {
      caso "approved payment returns a receipt" {
        given {
          payment_id: "pay_demo_2026"
          amount_cents: 4200
        }
        expect {
          sucesso: verdadeiro
          approved: verdadeiro
          receipt_id: "receipt_pay_demo_2026_4200"
        }
      }
    }
  }
  task prepare_bootstrap_workspace {
    input {
      reason: Texto required
    }
    output {
      workspace_path: Texto
      agents_absent: Booleano
      contracts_absent: Booleano
    }
    rules {
      reason deve_ser preenchido
    }
    effects {
      fs.write demo bootstrap workspace criticidade = media
      auditoria build week bootstrap preparation criticidade = baixa
    }
    authz {
      escopo: sema.showcase.demo.bootstrap.preparar
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: obrigatoria
      input {
        reason: publico
      }
      output {
        workspace_path: publico
        agents_absent: publico
        contracts_absent: publico
      }
    }
    audit {
      evento: sema.showcase.demo.bootstrap_preparado
      ator: jurado.build_week
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      network.egress
      remover_arquivo_fora_de_demo_runtime
      copiar_agents_ou_contrato_para_seed_limpo
    }
    impl {
      js: lib.bootstrap_state.prepareBootstrapWorkspace
    }
    vinculos {
      arquivo: "lib/bootstrap-state.mjs"
      arquivo: "prepare-bootstrap.mjs"
      arquivo: "bootstrap-seed/project-before-sema.txt"
      simbolo: lib.bootstrap_state.prepareBootstrapWorkspace
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "recriar workspace a partir do seed limpo"
      criticidade_operacional: media
    }
    guarantees {
      workspace_path existe
      agents_absent == verdadeiro
      contracts_absent == verdadeiro
    }
    tests {
      caso "clean workspace has no Sema handshake" {
        given {
          reason: "record bootstrap take"
        }
        expect {
          sucesso: verdadeiro
          agents_absent: verdadeiro
          contracts_absent: verdadeiro
        }
      }
    }
  }
  task reset_demo_project {
    input {
      reason: Texto required
    }
    output {
      restored: Booleano
      implementation_symbol: Texto
    }
    rules {
      reason deve_ser preenchido
    }
    effects {
      fs.write demo payment implementation criticidade = media
      fs.write demo runtime semantic contract criticidade = media
      auditoria build week demo reset criticidade = baixa
    }
    authz {
      escopo: sema.showcase.demo.reset
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: obrigatoria
      input {
        reason: publico
      }
      output {
        restored: publico
        implementation_symbol: publico
      }
    }
    audit {
      evento: sema.showcase.demo.reset
      ator: jurado.build_week
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      network.egress
      escrever_fora_da_pasta_demo
    }
    impl {
      js: lib.project_state.resetProject
    }
    vinculos {
      arquivo: "lib/project-state.mjs"
      arquivo: "project/fixtures/payment.healthy.mjs"
      arquivo: "project/src/payment.mjs"
      simbolo: lib.project_state.resetProject
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "10s"
      retry: "nenhum"
      compensacao: "restaurar fixture saudavel"
      criticidade_operacional: media
    }
    guarantees {
      restored == verdadeiro
      implementation_symbol existe
    }
  }
  task run_demo_scenario {
    input {
      mode: Texto required
    }
    output {
      drift_detected: Booleano
      broken_symbol: Texto
      final_symbol: Texto
      receipt_guarantee_preserved: Booleano
      final_drift_clean: Booleano
    }
    rules {
      mode em [demo, smoke]
    }
    effects {
      fs.write demo payment implementation criticidade = media
      fs.write demo runtime semantic contract criticidade = media
      shell.exec sema drift criticidade = media
      auditoria build week demo scenario criticidade = media
    }
    authz {
      escopo: sema.showcase.demo.executar
      tenant: opcional
    }
    dados {
      classificacao_padrao: publico
      redacao_log: obrigatoria
      input {
        mode: publico
      }
      output {
        drift_detected: publico
        broken_symbol: publico
        receipt_guarantee_preserved: publico
        final_drift_clean: publico
      }
    }
    audit {
      evento: sema.showcase.demo.executada
      ator: jurado.build_week
      correlacao: request_id
      retencao: "30d"
      motivo: obrigatorio
    }
    forbidden {
      remover_garantia_receipt_id_para_fazer_drift_passar
      reconstruir_cli_local_para_executar_demo
      aceitar_falso_negativo_de_vinculo_quebrado
    }
    impl {
      js: lib.scenario.runScenario
    }
    vinculos {
      arquivo: "lib/scenario.mjs"
      arquivo: "project/fixtures/payment.broken.mjs"
      arquivo: "project/test/payment.test.mjs"
      simbolo: lib.scenario.runScenario
    }
    execucao {
      idempotencia: verdadeiro
      timeout: "120s"
      retry: "nenhum"
      compensacao: "restaurar fixture saudavel"
      criticidade_operacional: media
    }
    guarantees {
      drift_detected == verdadeiro
      broken_symbol existe
      final_symbol existe
      receipt_guarantee_preserved == verdadeiro
      final_drift_clean == verdadeiro
    }
    tests {
      caso "partial rename is detected and corrected" {
        given {
          mode: "smoke"
        }
        expect {
          sucesso: verdadeiro
          drift_detected: verdadeiro
          receipt_guarantee_preserved: verdadeiro
          final_drift_clean: verdadeiro
        }
      }
    }
  }
}
